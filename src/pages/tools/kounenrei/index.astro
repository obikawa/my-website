---
import Layout from '../../../layouts/Layout.astro';

// 賃金締切日の選択肢：1日〜30日＋末日。給与計算ソフトの設定をそのまま写せるよう全日を並べる
const cutoffDays = Array.from({ length: 30 }, (_, i) => i + 1);

const PAGE_URL = 'https://nagoyasakae.com/tools/kounenrei/';

// よくある質問（画面表示とFAQPage構造化データで共用）
const faqs = [
  {
    q: '高年齢雇用継続給付はいくらもらえますか？',
    a: '60歳以降に支払われた賃金に「支給率」を掛けた額です。支給率は賃金の低下率で決まり、令和7年4月1日以降に受給資格を満たした方は最大10％、令和7年3月31日以前に満たした方は最大15％です。たとえば60歳到達時の賃金月額が30万円で、60歳以降の賃金が18万円（低下率60％）なら、18万円×10％＝18,000円が毎月支給されます。',
  },
  {
    q: '賃金が何％下がると高年齢雇用継続給付の対象になりますか？',
    a: '60歳到達時の賃金月額と比べて、60歳以降の賃金が75％未満に下がった月が対象です。ちょうど75％では対象になりません。たとえば賃金月額が40万円なら、30万円未満に下がった月が支給対象になります。',
  },
  {
    q: '高年齢雇用継続給付を受けると年金は減りますか？',
    a: '特別支給の老齢厚生年金を受けている方は、年金の一部が支給停止されます。標準報酬月額が60歳到達時の賃金月額の64％以下（経過措置の方は61％以下）の場合、標準報酬月額の4％（同6％）が停止されます。ただし2026年時点で60〜65歳の男性は特別支給の老齢厚生年金の対象外のため、この調整は起こりません。実際に影響するのは、昭和41年4月1日以前生まれの女性が中心です。',
  },
  {
    q: '支給率が10％の人と15％の人がいるのはなぜですか？',
    a: '令和7年4月1日の法改正で、支給率の上限が15％から10％に引き下げられたためです。令和7年3月31日以前に受給資格（60歳到達など）を満たした方は、令和7年4月1日以降も引き続き上限15％が適用されます。60歳到達日は誕生日の前日なので、昭和40年4月1日生まれの方は到達日が令和7年3月31日となり、経過措置（15％）の対象です。',
  },
  {
    q: '60歳到達時の賃金月額はどうやって計算しますか？',
    a: '60歳到達日より前の「完全な賃金月」6か月分の賃金総額を180で割って賃金日額を出し、それを30倍します。完全な賃金月とは、賃金締切日の翌日から次の締切日までの1か月で、賃金支払基礎日数が11日以上ある月のことです。締切日の翌日から60歳到達日までの端数期間は、この6か月には含めません。賃金月額には上限522,000円・下限96,090円があります（令和8年8月1日〜令和9年7月31日）。',
  },
  {
    q: '高年齢雇用継続給付はいつ振り込まれますか？',
    a: '原則として2か月に1回、2か月分がまとめて振り込まれます。事業所ごとに奇数月型・偶数月型が決まっており、ハローワークから指定された支給申請月に申請します。支給決定から口座に入金されるまで、おおむね1週間かかります。',
  },
  {
    q: '通勤手当が3か月分まとめて支給される場合はどう計算しますか？',
    a: '支払われた月以降の各支給対象月に、1か月あたりの額を割り振って計上します。端数は最後の月に加算します。たとえば3か月分10,000円なら、3,333円・3,333円・3,334円として各月の賃金に含めます。',
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '高年齢雇用継続給付シミュレーター',
  description: '60歳以降の賃金低下で高年齢雇用継続給付がいくら支給されるかを、賃金証明書と同じ形式で計算する無料ツール。低下率・支給率・支給額の計算過程をすべて表示し、特別支給の老齢厚生年金との併給調整（在職老齢年金による停止を含む）まで確認できます。',
  url: PAGE_URL,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  inLanguage: 'ja',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  featureList: [
    '高年齢雇用継続基本給付金の支給額シミュレーション',
    '60歳到達時の賃金月額（みなし賃金日額）の算定',
    '雇用保険被保険者六十歳到達時等賃金証明書と同じ形式での入力',
    '低下率・支給率・支給額の計算過程の表示',
    '支給率10％（現行）と15％（経過措置）の自動判定',
    'みなし賃金（欠勤等による減額の加算）への対応',
    '通勤手当の月割り按分',
    '特別支給の老齢厚生年金との併給調整の計算',
    '在職老齢年金による支給停止額の計算',
    '2か月分の支給スケジュール表示',
    '計算結果の印刷・PDF保存',
  ],
  provider: {
    '@type': 'ProfessionalService',
    name: 'おびかわ社労士事務所',
    url: 'https://nagoyasakae.com/',
    address: {
      '@type': 'PostalAddress',
      addressLocality: '名古屋市中区',
      addressRegion: '愛知県',
      addressCountry: 'JP',
    },
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: '高年齢雇用継続給付の支給額を計算する手順',
  description: '60歳到達時の賃金月額を出し、低下率から支給率を求めて、高年齢雇用継続給付の支給額を計算する手順です。',
  inLanguage: 'ja',
  totalTime: 'PT5M',
  step: [
    { '@type': 'HowToStep', name: '賃金月額を出す', text: '60歳到達日より前の完全な賃金月6か月分の賃金総額を180で割り、30倍して賃金月額を求めます。上限522,000円・下限96,090円が適用されます。' },
    { '@type': 'HowToStep', name: 'みなし賃金を出す', text: '欠勤や遅刻などで減額された分を、実際に支払われた賃金に足し戻します。この額を低下率の判定に使います。' },
    { '@type': 'HowToStep', name: '低下率を出す', text: 'みなし賃金を賃金月額で割って100を掛けます。小数点以下第3位を四捨五入し、第2位まで求めます。75％以上なら支給されません。' },
    { '@type': 'HowToStep', name: '支給率を出す', text: '低下率が64％以下なら支給率は上限の10％。64％超75％未満なら「（−64×低下率＋4800）÷110×100÷低下率」で計算します。経過措置の方は61％・15％・別式になります。' },
    { '@type': 'HowToStep', name: '支給額を出す', text: '実際に支払われた賃金に支給率を掛け、小数点以下を切り捨てます。賃金と給付金の合計が支給限度額397,369円を超える場合は調整され、算定額が2,562円以下なら支給されません。' },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://nagoyasakae.com/' },
    { '@type': 'ListItem', position: 2, name: '小さな専門家アプリ', item: 'https://nagoyasakae.com/tools/' },
    { '@type': 'ListItem', position: 3, name: '高年齢雇用継続給付シミュレーター', item: PAGE_URL },
  ],
};
---

<Layout
  fullTitle="高年齢雇用継続給付シミュレーター｜支給額と年金の減額を無料計算｜おびかわ社労士事務所"
  title="高年齢雇用継続給付シミュレーター"
  description="60歳以降に賃金が下がったとき、高年齢雇用継続給付がいくらもらえるかを無料で計算。賃金証明書と同じ形式で入力でき、低下率・支給率・支給額の計算過程をすべて表示します。特別支給の老齢厚生年金との併給調整で年金がいくら減るかまで分かる、社労士監修のシミュレーターです。"
>

  <Fragment slot="head">
    <meta name="keywords" content="高年齢雇用継続給付,高年齢雇用継続基本給付金,シミュレーション,計算,支給額,支給率,低下率,賃金月額,みなし賃金日額,60歳到達時等賃金証明書,定年後,再雇用,在職老齢年金,特別支給の老齢厚生年金,併給調整,年金,減額,社労士,名古屋,無料" />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- ===== ヒーロー ===== -->
  <section class="kn-hero bg-gradient-to-br from-primary-800 to-primary-600 text-white py-16 px-4">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-primary-200 text-sm font-medium tracking-widest uppercase mb-3">Free Tools</p>
      <h1 class="text-4xl font-bold">高年齢雇用継続給付シミュレーター</h1>
      <p class="mt-4 text-primary-100 max-w-2xl mx-auto">
        60歳からの賃金がいくら下がると、給付金がいくら出るのか。<br />
        賃金証明書と同じ形式で入力し、計算過程と年金への影響まで確認できます。
      </p>
    </div>
  </section>

  <!-- ===== パンくずリスト ===== -->
  <nav aria-label="パンくずリスト" class="kn-crumb border-b border-gray-100 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500">
        <li><a href="/" class="hover:text-primary-700 transition-colors">ホーム</a></li>
        <li class="text-gray-300" aria-hidden="true">›</li>
        <li><a href="/tools/" class="hover:text-primary-700 transition-colors">小さな専門家アプリ</a></li>
        <li class="text-gray-300" aria-hidden="true">›</li>
        <li class="text-gray-800 font-medium" aria-current="page">高年齢雇用継続給付シミュレーター</li>
      </ol>
    </div>
  </nav>

  <div class="kn-root">
    <div class="kn-container">

      <!-- ===== このツールについて（概要） ===== -->
      <div class="kn-card kn-about">
        <h2>このツールでできること</h2>
        <p class="kn-lead">
          <strong>高年齢雇用継続基本給付金</strong>は、60歳以降に賃金が60歳到達時の75％未満に下がったとき、
          下がった賃金の最大10％（経過措置の方は最大15％）が雇用保険から支給される制度です。
          このシミュレーターは、その支給額を<strong>計算過程まで見える形</strong>で確認できる無料ツールです。
        </p>
        <ul class="kn-featurelist">
          <li><strong>賃金証明書と同じ形式で入力</strong>できます。「雇用保険被保険者六十歳到達時等賃金証明書」の様式に沿って6か月分の賃金を入力すると、賃金月額（みなし賃金日額）が自動で求まります。端数期間や基礎日数11日未満の月も正しく判定します。</li>
          <li><strong>計算過程をすべて表示</strong>します。賃金月額 → みなし賃金 → 低下率 → 支給率 → 支給額の5ステップを、数式と実際の数字を並べて示すので、なぜその金額になるのかが分かります。</li>
          <li><strong>年金がいくら減るかまで分かります。</strong>特別支給の老齢厚生年金を受けている方は、①在職老齢年金による支給停止と、②高年齢雇用継続給付との併給調整の2段階で年金が減ります。その両方を計算式つきで表示します。</li>
          <li><strong>支給率10％と15％を自動で判定</strong>します。生年月日から60歳到達日（誕生日の前日）を求め、令和7年4月1日の改正前後どちらの区分かを判別します。</li>
          <li><strong>結果を印刷・PDF保存</strong>できます。従業員名・会社名を入れてA4で出力できるので、面談資料としてそのまま使えます。</li>
        </ul>
        <p class="kn-note-sm">
          社会保険労務士が制度の条文と厚生労働省の資料をもとに作成しています。入力した内容がサーバーに送信されることはありません。
        </p>
      </div>

      <!-- ===== ① 受給資格 ===== -->
      <div class="kn-card">
        <h2>① 受給資格を確認する</h2>
        <p class="kn-lead">生年月日から60歳到達日と支給率の区分（10％／15％）を自動で判定します。</p>

        <div class="kn-grid">
          <div class="kn-field">
            <label for="knBirth">生年月日</label>
            <input type="date" id="knBirth" />
            <span class="kn-hint">60歳到達日は誕生日の「前日」です</span>
          </div>
          <div class="kn-field">
            <label>性別</label>
            <div class="kn-pills" id="knGender">
              <label class="kn-on"><input type="radio" name="knG" value="male" checked />男性</label>
              <label><input type="radio" name="knG" value="female" />女性</label>
            </div>
            <span class="kn-hint">年金との併給調整の判定に使います</span>
          </div>
          <div class="kn-field">
            <label for="knInsured">雇用保険の被保険者であった期間</label>
            <select id="knInsured">
              <option value="1" selected>5年以上ある</option>
              <option value="0">5年未満</option>
            </select>
            <span class="kn-hint">通算5年以上が受給の条件です</span>
          </div>
        </div>

        <div class="kn-result-strip" id="knEligibility"></div>

        <details class="kn-help">
          <summary>支給率の区分を手動で指定する</summary>
          <p class="kn-note-sm">
            60歳到達後に「被保険者期間5年」を満たした場合など、受給資格の発生日が60歳到達日と異なるときは手動で指定してください。
          </p>
          <div class="kn-pills kn-pills-wide" id="knRateMode">
            <label class="kn-on"><input type="radio" name="knRM" value="auto" checked />自動判定</label>
            <label><input type="radio" name="knRM" value="current" />現行（上限10％）</label>
            <label><input type="radio" name="knRM" value="transitional" />経過措置（上限15％）</label>
          </div>
        </details>
      </div>

      <!-- ===== ② 賃金月額 ===== -->
      <div class="kn-card">
        <h2>② 60歳到達時の賃金月額を出す</h2>
        <p class="kn-lead">
          ハローワークに出す「雇用保険被保険者六十歳到達時等賃金証明書」と同じ形式です。<br />
          60歳到達日から遡って、賃金を<strong>固定給</strong>と<strong>変動給</strong>に分けて入力してください。
          1行目は「直近の賃金締切日の翌日〜60歳到達日」の<strong>端数期間</strong>になります（証明書には記入しますが、賃金月額の算定には使いません）。
        </p>

        <div class="kn-tabs" id="knWageTabs">
          <button type="button" class="kn-on" data-tab="table">賃金証明書から計算する</button>
          <button type="button" data-tab="direct">賃金月額を直接入力する</button>
        </div>

        <div id="knPaneTable">
          <div class="kn-grid kn-grid-2" style="margin-bottom:14px;">
            <div class="kn-field">
              <label for="knPayType">給与形態</label>
              <select id="knPayType">
                <option value="full">完全月給制（欠勤しても給与は減らない）</option>
                <option value="monthly" selected>日給月給制（欠勤したら控除される）</option>
                <option value="daily">日給制・時給制</option>
              </select>
              <span class="kn-hint">賃金支払基礎日数の数え方とA欄・B欄の扱いが変わります</span>
            </div>
            <div class="kn-field">
              <label for="knCutoff">賃金締切日</label>
              <select id="knCutoff">
                {cutoffDays.map((d) => <option value={d}>{d}日締め</option>)}
                <option value="31" selected>末日締め</option>
              </select>
              <span class="kn-hint">給与計算ソフトの設定と同じ日を選んでください（末日締めは月末＝28〜31日）</span>
            </div>
          </div>

          <div class="kn-tablewrap">
            <table class="kn-wagetable">
              <thead>
                <tr>
                  <th class="kn-th-no">No</th>
                  <th class="kn-th-period">賃金支払対象期間</th>
                  <th class="kn-th-days">賃金支払<br />基礎日数</th>
                  <th>固定給<br /><span class="kn-th-sub" id="knThFixed">基本給・役職手当・家族手当・通勤手当</span></th>
                  <th>変動給<br /><span class="kn-th-sub" id="knThVar">時間外手当・休日手当</span></th>
                  <th class="kn-th-work">労働日数<br /><span class="kn-th-sub">日給・時給制のみ</span></th>
                  <th class="kn-th-sum">計</th>
                </tr>
              </thead>
              <tbody id="knWageRows"></tbody>
              <tfoot>
                <tr>
                  <td colspan="3" class="kn-tf-label">算定に使う6か月の合計</td>
                  <td class="kn-tf-num" id="knSumA">0</td>
                  <td class="kn-tf-num" id="knSumB">0</td>
                  <td class="kn-tf-num" id="knSumWork">0</td>
                  <td class="kn-tf-num kn-tf-total" id="knSumAll">0</td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="kn-rowbtns">
            <button type="button" id="knAddRow" class="kn-minibtn">＋ 行を追加（欠勤で11日未満の月がある場合はさらに遡ります）</button>
            <button type="button" id="knFillAll" class="kn-minibtn">最初の完全な賃金月の金額を、以降の行にコピー</button>
          </div>

          <details class="kn-help">
            <summary>固定給・変動給の分け方と、賃金支払基礎日数の数え方</summary>
            <div class="kn-abtable">
              <div>
                <h4>固定給に入れるもの</h4>
                <ul>
                  <li>基本給</li>
                  <li>役職手当・家族手当などの固定手当</li>
                  <li>通勤手当（1か月分。3か月分一括なら1か月分に割る）</li>
                </ul>
              </div>
              <div>
                <h4>変動給に入れるもの</h4>
                <ul>
                  <li>時間外手当・休日手当</li>
                  <li>日給・時間給で計算される部分</li>
                  <li>歩合給・出来高払い</li>
                </ul>
              </div>
            </div>
            <p class="kn-note-sm">
              賞与など3か月を超える期間ごとに支払われるものは、どちらにも入れません。
            </p>
            <h4 class="kn-sub-h4">賃金支払基礎日数の数え方</h4>
            <ul class="kn-daysguide">
              <li><strong>完全月給制</strong>：欠勤しても給与が減らないため、その月の<strong>暦日数（30日・31日）</strong>。自動で入ります。</li>
              <li><strong>日給月給制</strong>：<strong>所定労働日数 − 欠勤日数</strong>。有給休暇を取った日は日数に含めます。</li>
              <li><strong>日給制・時給制</strong>：<strong>出勤した日数</strong>（有給休暇を取った日も含む）。</li>
            </ul>
            <p class="kn-note-sm">
              11日未満の月は算定から外れ、その分さらに前の月まで遡ります。
            </p>
            <h4 class="kn-sub-h4">賃金証明書のA欄・B欄との対応</h4>
            <p class="kn-note-sm">
              <strong>完全月給制・日給月給制</strong>は、固定給も変動給も「月によって定められた賃金」としてまとめて<strong>A欄</strong>に記載します。<br />
              <strong>日給制・時給制</strong>は、固定給を<strong>A欄</strong>、変動給を<strong>B欄</strong>に分けて記載し、B欄がある場合は「最低保障」も計算して金額が高い方を賃金日額とします。
            </p>
          </details>
        </div>

        <div id="knPaneDirect" class="kn-hidden">
          <div class="kn-grid kn-grid-2">
            <div class="kn-field">
              <label for="knWageDirect">賃金月額（受給資格確認通知書に記載の額）</label>
              <div class="kn-inputrow"><input type="number" id="knWageDirect" value="400000" step="1000" /><span class="kn-unit">円</span></div>
              <span class="kn-hint">ハローワークから通知された額が分かる場合はこちら</span>
            </div>
          </div>
        </div>

        <div class="kn-wageresult" id="knWageResult"></div>
      </div>

      <!-- ===== ③ 今の賃金 ===== -->
      <div class="kn-card">
        <h2>③ 60歳以降に支払われる賃金を入力する</h2>
        <p class="kn-lead">給付金は2か月に1回まとめて支給されます。支給対象となる2か月分を入力してください。</p>

        <div class="kn-grid kn-grid-2" style="margin-bottom:18px;">
          <div class="kn-field">
            <label for="knMonthAY">1か月目（支給対象月A）</label>
            <div class="kn-inputrow kn-ym">
              <select id="knMonthAY"></select><span class="kn-unit">年</span>
              <select id="knMonthAM"></select><span class="kn-unit">月</span>
            </div>
          </div>
          <div class="kn-field">
            <label>2か月目（支給対象月B）</label>
            <div class="kn-readout" id="knMonthBLabel">—</div>
            <span class="kn-hint">1か月目の翌月が自動で設定されます</span>
          </div>
        </div>

        <div class="kn-months">
          <div class="kn-monthcard kn-ma">
            <div class="kn-mc-head"><span class="kn-badge kn-badge-a">1か月目</span><span id="knMcLabelA">—</span></div>
            <div class="kn-field"><label>基本給・固定手当</label><div class="kn-inputrow"><input type="number" id="knMaBase" value="260000" step="1000" /><span class="kn-unit">円</span></div></div>
            <div class="kn-field"><label>残業手当・歩合など</label><div class="kn-inputrow"><input type="number" id="knMaVar" value="0" step="1000" /><span class="kn-unit">円</span></div></div>
            <div class="kn-field"><label>欠勤・遅刻等による減額<span class="kn-tag">みなし賃金</span></label><div class="kn-inputrow"><input type="number" id="knMaCut" value="0" step="1000" /><span class="kn-unit">円</span></div><span class="kn-hint">減額分は低下率の判定に加算されます</span></div>
          </div>
          <div class="kn-monthcard kn-mb">
            <div class="kn-mc-head"><span class="kn-badge kn-badge-b">2か月目</span><span id="knMcLabelB">—</span></div>
            <div class="kn-field"><label>基本給・固定手当</label><div class="kn-inputrow"><input type="number" id="knMbBase" value="260000" step="1000" /><span class="kn-unit">円</span></div></div>
            <div class="kn-field"><label>残業手当・歩合など</label><div class="kn-inputrow"><input type="number" id="knMbVar" value="0" step="1000" /><span class="kn-unit">円</span></div></div>
            <div class="kn-field"><label>欠勤・遅刻等による減額<span class="kn-tag">みなし賃金</span></label><div class="kn-inputrow"><input type="number" id="knMbCut" value="0" step="1000" /><span class="kn-unit">円</span></div><span class="kn-hint">減額分は低下率の判定に加算されます</span></div>
          </div>
        </div>

        <div class="kn-commute">
          <h3>通勤手当の扱い</h3>
          <p class="kn-note-sm">3か月・6か月分をまとめて支給している場合は、1か月あたりの額に割り振って各月に計上します（端数は最後の月に加算）。</p>
          <div class="kn-grid kn-grid-3">
            <div class="kn-field">
              <label for="knCommuteCycle">支給のしかた</label>
              <select id="knCommuteCycle">
                <option value="0" selected>通勤手当なし・基本給に含めた</option>
                <option value="1">毎月支給</option>
                <option value="3">3か月分をまとめて支給</option>
                <option value="6">6か月分をまとめて支給</option>
              </select>
            </div>
            <div class="kn-field">
              <label for="knCommuteAmt">1回の支給額</label>
              <div class="kn-inputrow"><input type="number" id="knCommuteAmt" value="0" step="1000" /><span class="kn-unit">円</span></div>
            </div>
            <div class="kn-field" id="knCommuteOffsetField">
              <label for="knCommuteOffset">直近の一括支給月</label>
              <select id="knCommuteOffset"></select>
              <span class="kn-hint">いつ支払ったかで各月の額が変わります</span>
            </div>
          </div>
          <div class="kn-commute-result" id="knCommuteResult"></div>
        </div>
      </div>

      <!-- ===== ④ 結果 ===== -->
      <div class="kn-card" id="knResultCard">

        <div class="kn-print-header" id="knPrintHeader" aria-hidden="true">
          <div class="kn-ph-top">
            <div class="kn-ph-company" id="knPhCompany"></div>
            <div class="kn-ph-recipient"><span id="knPhEmployee">________________</span> 様</div>
          </div>
          <h2 class="kn-ph-title">高年齢雇用継続給付 シミュレーション結果</h2>
          <div class="kn-ph-meta" id="knPhMeta"></div>
        </div>

        <h2>④ 計算結果と、その計算過程</h2>

        <div class="kn-summary" id="knSummary"></div>

        <h3 class="kn-h3">計算の流れ</h3>
        <div class="kn-steps" id="knSteps"></div>

        <h3 class="kn-h3">2か月分の支給スケジュール</h3>
        <div class="kn-schedule" id="knSchedule"></div>

        <h3 class="kn-h3">年金との併給調整</h3>
        <div class="kn-pension" id="knPension"></div>

        <div class="kn-print-panel">
          <div class="kn-pp-title">📄 この結果を印刷 / PDF保存</div>
          <p class="kn-note-sm">従業員名・会社名を入力すると印刷物に反映されます。</p>
          <div class="kn-grid kn-grid-2" style="margin-bottom:14px;">
            <div class="kn-field"><label for="knEmpName">従業員名（印刷用）</label><input type="text" id="knEmpName" placeholder="例：山田 太郎" /></div>
            <div class="kn-field"><label for="knCoName">会社名（印刷用）</label><input type="text" id="knCoName" placeholder="例：株式会社サンプル" /></div>
          </div>
          <button type="button" id="knPrintBtn" class="kn-printbtn">🖨 印刷 / PDF保存する</button>
        </div>

        <h3 class="kn-h3">計算の前提</h3>
        <ul class="kn-assumptions" id="knAssumptions"></ul>
        <p class="kn-disclaimer">
          このツールは概算を示すものです。実際の支給額・支給の可否は、ハローワークが賃金台帳等を確認して決定します。
          賃金締切日と60歳到達日の関係によっては、賃金支払対象期間の区切り方が異なる場合があります。
          正確な金額は管轄のハローワークまたは社会保険労務士にご確認ください。
        </p>
      </div>

      <!-- ===== よくあるご質問 ===== -->
      <div class="kn-card kn-faq">
        <h2>高年齢雇用継続給付のよくあるご質問</h2>
        <div class="kn-faqlist">
          {faqs.map((f) => (
            <div class="kn-faqitem">
              <h3><span class="kn-q">Q.</span>{f.q}</h3>
              <p><span class="kn-a">A.</span>{f.a}</p>
            </div>
          ))}
        </div>
        <div class="kn-related">
          <h3>関連ページ</h3>
          <ul>
            <li><a href="/tools/">ほかの無料ツールを見る（最低賃金・産後パパ育休・有給休暇）</a></li>
            <li><a href="/price/">顧問契約・手続き業務の料金表</a></li>
            <li><a href="/contact/">高年齢雇用継続給付の手続きについて相談する</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style is:global>
  .kn-root {
    --kn-bg: #f7f9fb;
    --kn-card: #fff;
    --kn-text: #16202f;
    --kn-sub: #5b6779;
    --kn-line: #e2e7ee;
    --kn-primary: #1d4fa3;
    --kn-primary-soft: #eaf1fb;
    --kn-accent: #b8791c;
    --kn-accent-soft: #fdf4e3;
    --kn-danger: #c4443f;
    --kn-danger-soft: #fdeceb;
    --kn-ok: #0e7a55;
    --kn-ok-soft: #e6f4ee;
    --kn-teal: #0f766e;
    --kn-radius: 10px;
    --kn-shadow: 0 4px 20px rgba(29,79,163,.08);
    background: var(--kn-bg);
    color: var(--kn-text);
    line-height: 1.75;
    font-size: 15px;
  }
  .kn-root .kn-container { max-width: 1020px; margin: 0 auto; padding: 32px 16px 64px; }
  .kn-root .kn-card { background: var(--kn-card); border: 1px solid var(--kn-line); border-radius: var(--kn-radius); box-shadow: var(--kn-shadow); padding: 26px; margin-bottom: 24px; }
  .kn-root .kn-card > h2 { font-size: 19px; font-weight: 700; margin: 0 0 8px; padding-bottom: 11px; border-bottom: 2px solid var(--kn-primary); display: inline-block; }
  .kn-root .kn-h3 { font-size: 16px; font-weight: 700; margin: 32px 0 12px; padding-left: 11px; border-left: 4px solid var(--kn-primary); }
  .kn-root .kn-lead { font-size: 14px; color: var(--kn-sub); margin: 12px 0 20px; }
  .kn-root .kn-hidden { display: none !important; }

  /* --- フォーム --- */
  .kn-root .kn-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
  .kn-root .kn-grid-2 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .kn-root .kn-grid-3 { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .kn-root .kn-field { display: flex; flex-direction: column; gap: 6px; }
  .kn-root .kn-field label { font-size: 13px; font-weight: 600; }
  .kn-root .kn-tag { display: inline-block; font-size: 10px; font-weight: 700; color: #fff; background: var(--kn-accent); padding: 1px 6px; border-radius: 3px; margin-left: 6px; vertical-align: 1px; }
  .kn-root input[type="number"], .kn-root input[type="text"], .kn-root input[type="date"], .kn-root select {
    width: 100%; padding: 9px 11px; border: 1px solid var(--kn-line); border-radius: 6px;
    font-size: 15px; font-family: inherit; color: var(--kn-text); background: #fff; box-sizing: border-box;
  }
  .kn-root input:focus, .kn-root select:focus { outline: 2px solid var(--kn-primary); outline-offset: -1px; }
  .kn-root .kn-inputrow { display: flex; align-items: center; gap: 7px; }
  .kn-root .kn-unit { font-size: 13px; color: var(--kn-sub); white-space: nowrap; }
  .kn-root .kn-ym select { min-width: 82px; }
  .kn-root .kn-hint { font-size: 11.5px; color: var(--kn-sub); line-height: 1.55; }
  .kn-root .kn-readout { padding: 9px 11px; border: 1px dashed var(--kn-line); border-radius: 6px; font-weight: 700; background: #fbfcfe; }
  .kn-root .kn-note-sm { font-size: 12.5px; color: var(--kn-sub); margin: 8px 0; line-height: 1.7; }

  .kn-root .kn-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .kn-root .kn-pills label { padding: 8px 14px; border: 1px solid var(--kn-line); border-radius: 999px; font-size: 13px; cursor: pointer; background: #fff; transition: .15s; }
  .kn-root .kn-pills label:hover { border-color: var(--kn-primary); }
  .kn-root .kn-pills label.kn-on { background: var(--kn-primary); color: #fff; border-color: var(--kn-primary); font-weight: 600; }
  .kn-root .kn-pills input { display: none; }

  .kn-root .kn-tabs { display: flex; gap: 4px; border-bottom: 2px solid var(--kn-line); margin-bottom: 20px; }
  .kn-root .kn-tabs button { padding: 10px 18px; border: none; background: none; font-size: 14px; font-family: inherit; color: var(--kn-sub); cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -2px; }
  .kn-root .kn-tabs button.kn-on { color: var(--kn-primary); font-weight: 700; border-bottom-color: var(--kn-primary); }

  .kn-root .kn-help { margin-top: 18px; border: 1px solid var(--kn-line); border-radius: 8px; padding: 0 14px; background: #fbfcfe; }
  .kn-root .kn-help summary { cursor: pointer; font-size: 13px; font-weight: 600; padding: 11px 0; color: var(--kn-primary); }
  .kn-root .kn-help[open] { padding-bottom: 14px; }
  .kn-root .kn-pills-wide { margin-top: 8px; }

  /* --- 賃金証明書テーブル --- */
  .kn-root .kn-tablewrap { overflow-x: auto; border: 1px solid var(--kn-line); border-radius: 8px; }
  .kn-root .kn-wagetable { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 720px; }
  .kn-root .kn-wagetable th { background: var(--kn-primary-soft); color: var(--kn-text); font-weight: 700; padding: 9px 8px; text-align: center; border-bottom: 1px solid var(--kn-line); font-size: 12px; line-height: 1.4; }
  .kn-root .kn-th-sub { font-weight: 400; font-size: 10.5px; color: var(--kn-sub); }
  .kn-root .kn-th-no { width: 40px; }
  .kn-root .kn-th-period { width: 140px; }
  .kn-root .kn-th-days { width: 84px; }
  .kn-root .kn-th-work { width: 88px; }
  .kn-root .kn-th-sum { width: 92px; }
  .kn-root .kn-wagetable td { padding: 5px 6px; border-bottom: 1px solid #f0f3f7; text-align: center; }
  .kn-root .kn-wagetable tbody tr.kn-excluded { background: #f6f7f9; color: #9aa4b2; }
  .kn-root .kn-wagetable tbody tr.kn-excluded input { color: #9aa4b2; background: #f6f7f9; }
  .kn-root .kn-wagetable input { padding: 6px 7px; font-size: 13px; text-align: right; }
  .kn-root .kn-rowno { font-weight: 700; color: var(--kn-sub); }
  .kn-root .kn-period { font-size: 11.5px; color: var(--kn-sub); white-space: nowrap; }
  .kn-root .kn-cell-sum { font-weight: 700; text-align: right; padding-right: 10px; white-space: nowrap; }
  .kn-root .kn-exbadge { display: inline-block; font-size: 9.5px; font-weight: 700; color: #fff; background: #9aa4b2; padding: 1px 5px; border-radius: 3px; margin-top: 2px; }
  .kn-root .kn-exbadge-p { background: var(--kn-accent); }
  .kn-root .kn-usebadge { display: inline-block; font-size: 9.5px; font-weight: 700; color: #fff; background: var(--kn-ok); padding: 1px 5px; border-radius: 3px; margin-top: 2px; }
  .kn-root .kn-wagetable tbody tr.kn-partial { background: var(--kn-accent-soft); }
  .kn-root .kn-wagetable tfoot td { padding: 10px 8px; background: #fbfcfe; border-top: 2px solid var(--kn-line); font-size: 13px; }
  .kn-root .kn-tf-label { text-align: right; font-weight: 600; color: var(--kn-sub); }
  .kn-root .kn-tf-num { text-align: right; font-weight: 700; padding-right: 10px !important; }
  .kn-root .kn-tf-total { color: var(--kn-primary); }
  .kn-root .kn-rowbtns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .kn-root .kn-minibtn { padding: 7px 14px; border: 1px solid var(--kn-line); background: #fff; border-radius: 6px; font-size: 12.5px; font-family: inherit; color: var(--kn-primary); cursor: pointer; }
  .kn-root .kn-minibtn:hover { background: var(--kn-primary-soft); border-color: var(--kn-primary); }

  .kn-root .kn-abtable { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; margin: 6px 0 4px; }
  .kn-root .kn-abtable > div { background: #fff; border: 1px solid var(--kn-line); border-radius: 8px; padding: 14px 16px; }
  .kn-root .kn-abtable h4 { margin: 0 0 6px; font-size: 14px; color: var(--kn-primary); }
  .kn-root .kn-abtable p { margin: 0 0 8px; font-size: 12.5px; color: var(--kn-sub); }
  .kn-root .kn-abtable ul { margin: 0; padding-left: 18px; font-size: 12.5px; }
  .kn-root .kn-abtable li { margin-bottom: 3px; }
  .kn-root .kn-sub-h4 { font-size: 13.5px; font-weight: 700; margin: 16px 0 6px; color: var(--kn-primary); }
  .kn-root .kn-daysguide { margin: 0; padding-left: 18px; font-size: 12.5px; line-height: 1.85; }
  .kn-root .kn-daysguide li { margin-bottom: 3px; }
  .kn-root .kn-wagetable input[readonly] { background: #f1f4f8; color: var(--kn-sub); cursor: not-allowed; }

  /* --- 判定ストリップ・賃金月額結果 --- */
  .kn-root .kn-result-strip { margin-top: 18px; padding: 14px 16px; border-radius: 8px; font-size: 13.5px; line-height: 1.8; background: var(--kn-primary-soft); border-left: 4px solid var(--kn-primary); }
  .kn-root .kn-result-strip.kn-ng { background: var(--kn-danger-soft); border-left-color: var(--kn-danger); }
  .kn-root .kn-result-strip strong { font-weight: 700; }
  .kn-root .kn-wageresult { margin-top: 20px; }
  .kn-root .kn-calcbox { background: #fbfcfe; border: 1px solid var(--kn-line); border-radius: 8px; padding: 16px 18px; }
  .kn-root .kn-calcline { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; padding: 7px 0; border-bottom: 1px dashed #e8ecf2; font-size: 13.5px; }
  .kn-root .kn-calcline:last-child { border-bottom: none; }
  .kn-root .kn-calclabel { font-weight: 600; min-width: 130px; }
  .kn-root .kn-formula { font-family: ui-monospace, "SFMono-Regular", Consolas, monospace; font-size: 12.5px; color: var(--kn-sub); background: #fff; border: 1px solid var(--kn-line); border-radius: 4px; padding: 2px 8px; }
  .kn-root .kn-calcval { margin-left: auto; font-weight: 700; white-space: nowrap; }
  .kn-root .kn-adopted { display: inline-block; font-size: 10.5px; font-weight: 700; color: #fff; background: var(--kn-ok); padding: 1px 7px; border-radius: 3px; }
  .kn-root .kn-capbadge { display: inline-block; font-size: 10.5px; font-weight: 700; color: #fff; background: var(--kn-accent); padding: 1px 7px; border-radius: 3px; }
  .kn-root .kn-final { margin-top: 12px; padding: 13px 16px; background: var(--kn-primary); color: #fff; border-radius: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .kn-root .kn-final .kn-fl { font-size: 13px; font-weight: 600; }
  .kn-root .kn-final .kn-fv { margin-left: auto; font-size: 22px; font-weight: 700; }

  /* --- 支給対象月カード --- */
  .kn-root .kn-months { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .kn-root .kn-monthcard { border: 1px solid var(--kn-line); border-top: 4px solid var(--kn-primary); border-radius: 8px; padding: 16px 18px; display: flex; flex-direction: column; gap: 13px; }
  .kn-root .kn-monthcard.kn-mb { border-top-color: var(--kn-accent); }
  .kn-root .kn-mc-head { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14px; }
  .kn-root .kn-badge { display: inline-block; font-size: 11px; font-weight: 700; color: #fff; background: var(--kn-primary); padding: 2px 9px; border-radius: 999px; }
  .kn-root .kn-badge-b { background: var(--kn-accent); }

  .kn-root .kn-commute { margin-top: 24px; padding: 18px; background: #fbfcfe; border: 1px solid var(--kn-line); border-radius: 8px; }
  .kn-root .kn-commute h3 { margin: 0 0 4px; font-size: 15px; font-weight: 700; }
  .kn-root .kn-commute-result { margin-top: 14px; font-size: 13px; }
  .kn-root .kn-commute-result:empty { display: none; }
  .kn-root .kn-alloc { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .kn-root .kn-alloc span { background: #fff; border: 1px solid var(--kn-line); border-radius: 6px; padding: 5px 11px; font-size: 12.5px; }
  .kn-root .kn-alloc span.kn-hit { border-color: var(--kn-primary); background: var(--kn-primary-soft); font-weight: 700; }

  /* --- 結果サマリー --- */
  .kn-root .kn-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; margin: 20px 0 8px; }
  .kn-root .kn-sumcard { border: 1px solid var(--kn-line); border-top: 4px solid var(--kn-primary); border-radius: 8px; padding: 15px 16px; }
  .kn-root .kn-sumcard.kn-b { border-top-color: var(--kn-accent); }
  .kn-root .kn-sumcard.kn-tot { border-top-color: var(--kn-ok); background: var(--kn-ok-soft); }
