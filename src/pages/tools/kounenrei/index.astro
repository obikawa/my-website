<script is:inline>
(function(){
  'use strict';

  /* ===================================================================
     定数（法改正時はこのブロックだけ直せばよい）
     =================================================================== */

  // 雇用保険の限度額：毎年8月1日に「毎月勤労統計」の平均定期給与額により改定
  var KN_LIMITS = {
    label: '令和8年8月1日〜令和9年7月31日',
    wageMonthlyMax: 522000,  // 賃金月額の上限（令和8年8月改定：508,200円→522,000円）
    wageMonthlyMin: 96090,   // 賃金月額の下限（同：90,420円→96,090円）
    benefitLimit:   397369,  // 支給限度額（同：386,922円→397,369円）
    benefitMin:     2562     // 最低限度額（同：2,411円→2,562円。この額「以下」は不支給）
  };

  // 在職老齢年金の支給停止調整額：毎年4月改定
  var KN_ZAIROU = { label: '令和8年4月〜', threshold: 650000 };

  // 支給率の計算ルール
  //  rate = ((a*X + b) / d) * (100 / X)   ※ X = 低下率
  var KN_RATE_RULES = {
    current:      { max: 10, flatUpTo: 64, a:  -64, b:  4800, d: 110, pensionMax: 4, label: '現行（上限10％）' },
    transitional: { max: 15, flatUpTo: 61, a: -183, b: 13725, d: 280, pensionMax: 6, label: '経過措置（上限15％）' }
  };

  // 経過措置の境界：令和7年3月31日以前に受給資格を満たした人は上限15％
  var KN_TRANSITION_DATE = '2025-03-31';

  // 特別支給の老齢厚生年金（報酬比例部分）の支給開始年齢
  var KN_TIERS = {
    male: [
      { from:'1953-04-02', to:'1955-04-01', age:61 },
      { from:'1955-04-02', to:'1957-04-01', age:62 },
      { from:'1957-04-02', to:'1959-04-01', age:63 },
      { from:'1959-04-02', to:'1961-04-01', age:64 }
    ],
    female: [
      { from:'1958-04-02', to:'1960-04-01', age:61 },
      { from:'1960-04-02', to:'1962-04-01', age:62 },
      { from:'1962-04-02', to:'1964-04-01', age:63 },
      { from:'1964-04-02', to:'1966-04-01', age:64 }
    ]
  };

  var MIN_BASE_DAYS = 11;   // 賃金支払基礎日数
  var CALC_MONTHS   = 6;    // 算定に使う月数
  var DIVISOR       = 180;  // 賃金日額の除数

  /* ===================================================================
     ヘルパー
     =================================================================== */
  var $ = function(id){ return document.getElementById(id); };
  var num = function(id){ var e=$(id); return e ? (parseFloat(e.value)||0) : 0; };
  function yen(n){ return '¥' + Math.round(n).toLocaleString('ja-JP'); }
  function plain(n){ return Math.round(n).toLocaleString('ja-JP'); }
  function dec(n, k){ k = k===undefined?2:k; return (Math.round(n*Math.pow(10,k))/Math.pow(10,k)).toLocaleString('ja-JP',{minimumFractionDigits:k, maximumFractionDigits:k}); }

  // 小数点以下第3位を四捨五入して第2位まで
  function round2(n){ return Math.round(n*100)/100; }
  // 低下率（％）
  function ratio2(a,b){ if(!b) return 0; return round2(a/b*100); }
  // 支給額：率を整数化してから掛け、円未満切り捨て（浮動小数の1円ズレを防ぐ）
  function amountByRate(wage, rate){ return Math.floor(wage * Math.round(rate*100) / 10000); }

  function toDate(iso){ if(!iso) return null; var d=new Date(iso+'T00:00:00'); return isNaN(d.getTime())?null:d; }
  function fmtDate(d){ return d.getFullYear()+'年'+(d.getMonth()+1)+'月'+d.getDate()+'日'; }
  function fmtMD(d){ return (d.getMonth()+1)+'/'+d.getDate(); }
  function isoOf(d){ var m=d.getMonth()+1, dd=d.getDate(); return d.getFullYear()+'-'+(m<10?'0':'')+m+'-'+(dd<10?'0':'')+dd; }

  // 年齢到達日＝誕生日の前日（年齢計算ニ関スル法律）
  function reachDate(birthISO, years){
    var b = toDate(birthISO); if(!b) return null;
    var d = new Date(b.getFullYear()+years, b.getMonth(), b.getDate());
    d.setDate(d.getDate()-1);
    return d;
  }

  /* ===================================================================
     純関数：制度計算
     =================================================================== */

  // 支給率
  function calcRate(X, kind){
    var r = KN_RATE_RULES[kind];
    if (X >= 75)          return { rate:0,     branch:'over75' };
    if (X <= r.flatUpTo)  return { rate:r.max, branch:'flat' };
    var exact = ((r.a*X + r.b) / r.d) * (100 / X);
    return { rate: round2(exact), exact: exact, branch:'slope' };
  }

  // 「完全な賃金月」で基礎日数11日以上の月を、直近から6か月ぶん抽出
  //  端数期間（1行目）は完全な賃金月ではないため常に除外する
  function pickValidMonths(rows){
    var out = [];
    for (var i=0; i<rows.length && out.length<CALC_MONTHS; i++){
      if (rows[i].partial) continue;
      if (rows[i].days >= MIN_BASE_DAYS) out.push(i);
    }
    return out;
  }

  // 賃金日額
  //  payType: 'full'（完全月給制）'monthly'（日給月給制）→ 固定給・変動給ともA欄。最低保障なし
  //           'daily'（日給・時給制）→ 固定給＝A欄／変動給＝B欄。最低保障を計算
  function calcWageDaily(rows, validIdx, payType){
    var isDaily = (payType === 'daily');
    var sumFixed=0, sumVar=0, sumWork=0;
    for (var i=0;i<validIdx.length;i++){
      var r = rows[validIdx[i]];
      sumFixed += r.a; sumVar += r.b;
      sumWork += (r.work > 0 ? r.work : r.days);
    }
    var sumA = isDaily ? sumFixed : (sumFixed + sumVar);
    var sumB = isDaily ? sumVar : 0;
    var principle = (sumA + sumB) / DIVISOR;
    var hasB = sumB > 0;
    var guarantee = (hasB && sumWork > 0) ? (sumA/DIVISOR + (sumB/sumWork)*0.7) : null;
    var daily = principle, adopted = 'principle';
    if (guarantee !== null && guarantee > principle){ daily = guarantee; adopted = 'guarantee'; }
    return {
      sumFixed: sumFixed, sumVar: sumVar,
      sumA: sumA, sumB: sumB, sumWork: sumWork, sumAll: sumA+sumB,
      principle: principle, guarantee: guarantee, hasB: hasB, isDaily: isDaily,
      daily: daily, adopted: adopted, count: validIdx.length
    };
  }

  // 賃金月額（上限・下限を適用）
  function calcWageMonthly(daily){
    var raw = daily * 30;
    var applied = raw, capped=false, floored=false;
    if (raw > KN_LIMITS.wageMonthlyMax){ applied = KN_LIMITS.wageMonthlyMax; capped = true; }
    else if (raw < KN_LIMITS.wageMonthlyMin){ applied = KN_LIMITS.wageMonthlyMin; floored = true; }
    return { raw: raw, applied: Math.floor(applied), capped: capped, floored: floored };
  }

  // 通勤手当の按分（端数は最後の月に加算）
  function allocateCommute(amount, months){
    if (months <= 1) return [amount];
    var base = Math.floor(amount / months);
    var arr = [];
    for (var i=0;i<months;i++) arr.push(base);
    arr[months-1] = amount - base*(months-1);
    return arr;
  }

  // 1か月分の給付金
  //  o = { paid:実際に支払われた賃金, cut:減額分, wageMonthly:賃金月額, kind:区分 }
  function calcBenefitMonth(o){
    var paid = Math.max(0, Math.round(o.paid));
    var cut  = Math.max(0, Math.round(o.cut));
    var deemed = paid + cut;
    var res = { paid:paid, cut:cut, deemed:deemed, wageMonthly:o.wageMonthly, kind:o.kind,
                ratio:0, rate:0, raw:0, amount:0, capped:false, status:'ok' };

    // ① 支払賃金が支給限度額以上 → 不支給
    if (paid >= KN_LIMITS.benefitLimit){
      res.ratio = ratio2(deemed, o.wageMonthly);
      res.status = 'overLimit';
      return res;
    }
    // ② 低下率 → 支給率
    res.ratio = ratio2(deemed, o.wageMonthly);
    var ri = calcRate(res.ratio, o.kind);
    res.rate = ri.rate; res.rateBranch = ri.branch; res.rateExact = ri.exact;
    if (res.rate <= 0){ res.status = 'ratio75'; return res; }

    // ③ 支給額 → 支給限度額でキャップ
    res.raw = amountByRate(paid, res.rate);
    var amt = res.raw;
    if (paid + amt > KN_LIMITS.benefitLimit){
      amt = KN_LIMITS.benefitLimit - paid;
      res.capped = true;
    }
    res.cappedAmount = amt;

    // ④ 最低限度額以下 → 不支給
    if (amt <= KN_LIMITS.benefitMin){ res.status = 'underMin'; return res; }

    res.amount = amt;
    return res;
  }

  // 特別支給の老齢厚生年金の対象判定
  function judgeTokubetsu(birthISO, gender){
    var tiers = KN_TIERS[gender] || [];
    var b = toDate(birthISO);
    if (!b) return { eligible:false, reason:'nobirth' };
    for (var i=0;i<tiers.length;i++){
      var f = toDate(tiers[i].from), t = toDate(tiers[i].to);
      if (b >= f && b <= t) return { eligible:true, age:tiers[i].age, tier:tiers[i] };
    }
    return { eligible:false, reason: (b > toDate(tiers.length ? tiers[tiers.length-1].to : '1900-01-01')) ? 'tooYoung' : 'tooOld' };
  }

  // 在職老齢年金による支給停止
  function calcZaishoku(basicMonthly, totalRewardMonthly){
    var sum = basicMonthly + totalRewardMonthly;
    var th = KN_ZAIROU.threshold;
    if (sum <= th) return { sum:sum, threshold:th, stop:0, over:false };
    var stop = Math.floor((sum - th) / 2);
    if (stop > basicMonthly) stop = basicMonthly;
    return { sum:sum, threshold:th, stop:stop, over:true };
  }

  // 高年齢雇用継続給付との併給調整（年金の一部支給停止）
  function calcPensionCoordination(std, wageMonthly, kind, benefitPaid){
    var r = KN_RATE_RULES[kind];
    var res = { std:std, wageMonthly:wageMonthly, kind:kind, z:0, rate:0, amount:0 };
    if (!benefitPaid){ res.branch = 'noBenefit'; return res; }
    if (std >= KN_LIMITS.benefitLimit){ res.branch = 'overLimit'; return res; }
    var Z = ratio2(std, wageMonthly);
    res.z = Z;
    if (Z >= 75){ res.branch = 'over75'; return res; }
    if (Z <= r.flatUpTo){
      res.rate = r.pensionMax; res.branch = 'max';
    } else {
      var ri = calcRate(Z, kind);
      res.baseRate = ri.rate;
      res.rate = round2(ri.rate * 0.4);   // 支給率 × 0.4
      res.branch = 'slope';
    }
    res.amount = Math.floor(std * Math.round(res.rate*100) / 10000);
    return res;
  }

  // 賃金支払対象期間を締切日から生成
  //  1行目は「直近の賃金締切日の翌日 〜 60歳到達日」の端数期間（完全な賃金月ではないため算定対象外）
  //  2行目以降が「完全な賃金月」＝締切日の翌日から次の締切日までの1か月
  function buildPeriods(reachISO, cutoff, count){
    var d = toDate(reachISO);
    if (!d) return [];
    function cutoffDate(y, m){
      var last = new Date(y, m+1, 0).getDate();
      return new Date(y, m, Math.min(cutoff, last));
    }
    var y = d.getFullYear(), m = d.getMonth();
    var cd = cutoffDate(y, m);
    if (cd > d){ m--; if (m < 0){ m = 11; y--; } cd = cutoffDate(y, m); }

    var arr = [];
    // 到達日がちょうど締切日なら端数期間は生じない
    if (cd.getTime() !== d.getTime()){
      arr.push({
        start: new Date(cd.getFullYear(), cd.getMonth(), cd.getDate()+1),
        end: new Date(d.getTime()),
        partial: true
      });
    }
    while (arr.length < count){
      var end = cutoffDate(y, m);
      var sy = y, sm = m-1; if (sm < 0){ sm = 11; sy--; }
      var prev = cutoffDate(sy, sm);
      var start = new Date(prev.getFullYear(), prev.getMonth(), prev.getDate()+1);
      arr.push({ start: start, end: end, partial: false });
      m--; if (m < 0){ m = 11; y--; }
    }
    return arr;
  }

  // 開発時の検証用（コンソールから叩ける）
  window.__kn = {
    calcRate: calcRate, calcBenefitMonth: calcBenefitMonth, calcWageDaily: calcWageDaily,
    calcWageMonthly: calcWageMonthly, allocateCommute: allocateCommute,
    judgeTokubetsu: judgeTokubetsu, calcZaishoku: calcZaishoku,
    calcPensionCoordination: calcPensionCoordination, reachDate: reachDate,
    amountByRate: amountByRate, LIMITS: KN_LIMITS
  };

  /* ===================================================================
     状態
     =================================================================== */
  var rowCount = CALC_MONTHS + 1;  // 端数期間1行＋完全な賃金月6行
  var wageMode = 'table';          // 'table' | 'direct'
  var gender   = 'male';
  var rateMode = 'auto';           // 'auto' | 'current' | 'transitional'
  var payType  = 'monthly';        // 'full'（完全月給制）| 'monthly'（日給月給制）| 'daily'（日給・時給制）

  /* ===================================================================
     入力の初期化
     =================================================================== */
  function initSelects(){
    // 支給対象月（年）
    var nowY = new Date().getFullYear();
    var sy = $('knMonthAY'), h = '';
    for (var y = nowY-6; y <= nowY+6; y++) h += '<option value="'+y+'"'+(y===nowY?' selected':'')+'>'+y+'</option>';
    sy.innerHTML = h;
    // 支給対象月（月）
    var nowM = new Date().getMonth()+1, sm = $('knMonthAM'); h = '';
    for (var m = 1; m <= 12; m++) h += '<option value="'+m+'"'+(m===nowM?' selected':'')+'>'+m+'</option>';
    sm.innerHTML = h;
  }

  function renderCommuteOffset(){
    var cyc = parseInt($('knCommuteCycle').value, 10) || 0;
    var sel = $('knCommuteOffset');
    var field = $('knCommuteOffsetField');
    if (cyc <= 1){ field.style.display = 'none'; return; }
    field.style.display = '';
    var keep = sel.value, h = '';
    for (var i = 0; i < cyc; i++){
      var label = (i === 0) ? '1か月目（月A）に支給' : i + 'か月前に支給';
      h += '<option value="'+i+'">'+label+'</option>';
    }
    sel.innerHTML = h;
    if (keep && parseInt(keep,10) < cyc) sel.value = keep;
  }

  function buildWageRows(){
    var reach = getReachISO();
    var cutoff = parseInt($('knCutoff').value, 10) || 31;
    var periods = buildPeriods(reach, cutoff, rowCount);
    var body = $('knWageRows');
    var prev = readRows();          // 既存入力を保持
    var full = (payType === 'full');
    var h = '';
    for (var i = 0; i < rowCount; i++){
      var p = periods[i];
      var label = p ? (fmtMD(p.start) + '〜' + fmtMD(p.end)) : '—';
      var o = prev[i] || { days: 0, a: 400000, b: 0, work: 0 };
      var isPartial = !!(p && p.partial);
      // 完全月給制は暦日数を自動セット。それ以外は既存値（なければ22日）
      var calDays = p ? Math.round((p.end - p.start) / 86400000) + 1 : 30;
      var days = full ? calDays : (o.days > 0 ? o.days : (isPartial ? calDays : 22));
      h += '<tr data-row="'+i+'"'+(isPartial ? ' data-partial="1"' : '')+'>'
        +   '<td class="kn-rowno">'+(i+1)+'</td>'
        +   '<td class="kn-period">'+label+'<div class="kn-exflag"></div></td>'
        +   '<td><input type="number" class="kn-in-days" value="'+days+'" min="0" max="31" step="1"'+(full?' readonly':'')+' /></td>'
        +   '<td><input type="number" class="kn-in-a" value="'+o.a+'" step="1000" min="0" /></td>'
        +   '<td><input type="number" class="kn-in-b" value="'+o.b+'" step="1000" min="0" /></td>'
        +   '<td><input type="number" class="kn-in-work" value="'+(o.work||'')+'" placeholder="—" min="0" max="31" step="1" /></td>'
        +   '<td class="kn-cell-sum">0</td>'
        + '</tr>';
    }
    body.innerHTML = h;
    body.querySelectorAll('input').forEach(function(el){
      el.addEventListener('input', updateAll);
      el.addEventListener('change', updateAll);
    });
  }

  function readRows(){
    var out = [];
    var trs = $('knWageRows').querySelectorAll('tr');
    for (var i = 0; i < trs.length; i++){
      var tr = trs[i];
      var g = function(cls){ var e = tr.querySelector(cls); return e ? (parseFloat(e.value)||0) : 0; };
      out.push({ days: g('.kn-in-days'), a: g('.kn-in-a'), b: g('.kn-in-b'), work: g('.kn-in-work'),
                 partial: tr.getAttribute('data-partial') === '1' });
    }
    return out;
  }

  /* ===================================================================
     判定まわり
     =================================================================== */
  function getReachISO(){
    var d = reachDate($('knBirth').value, 60);
    return d ? isoOf(d) : null;
  }

  function getRateKind(){
    if (rateMode !== 'auto') return rateMode;
    var iso = getReachISO();
    if (!iso) return 'current';
    return (iso <= KN_TRANSITION_DATE) ? 'transitional' : 'current';
  }

  function renderEligibility(){
    var box = $('knEligibility');
    var birth = $('knBirth').value;
    var d = reachDate(birth, 60);
    var d65 = reachDate(birth, 65);
    var insured = $('knInsured').value === '1';
    if (!d){ box.className = 'kn-result-strip kn-ng'; box.innerHTML = '生年月日を入力してください。'; return; }

    var kind = getRateKind();
    var kindLabel = KN_RATE_RULES[kind].label;
    var auto = (rateMode === 'auto');
    var today = new Date(); today.setHours(0,0,0,0);
    var inRange = (today >= d && today < d65);

    var lines = [];
    lines.push('<div><strong>60歳到達日</strong>：' + fmtDate(d) + '（誕生日の前日）</div>');
    lines.push('<div><strong>支給対象期間</strong>：' + fmtDate(d) + ' 〜 ' + fmtDate(d65) + '（65歳到達月まで）</div>');
    lines.push('<div><strong>支給率の区分</strong>：' + kindLabel + (auto ? '　<span class="kn-hint">※60歳到達日が令和7年3月31日' + (kind==='transitional' ? '以前' : 'より後') + 'のため自動判定</span>' : '　<span class="kn-hint">※手動指定</span>') + '</div>');

    if (!insured){
      box.className = 'kn-result-strip kn-ng';
      lines.push('<div style="margin-top:6px;"><strong>被保険者であった期間が5年未満のため、現時点では受給できません。</strong>5年に達した日から対象になります。</div>');
    } else if (!inRange){
      box.className = 'kn-result-strip';
      lines.push('<div style="margin-top:6px;">現在は60〜65歳の範囲外ですが、上記期間の想定として計算します。</div>');
    } else {
      box.className = 'kn-result-strip';
      lines.push('<div style="margin-top:6px;"><strong>受給資格の要件（60歳以上65歳未満・被保険者期間5年以上）を満たしています。</strong></div>');
    }
    box.innerHTML = lines.join('');
  }

  /* ===================================================================
     ② 賃金月額
     =================================================================== */
  function computeWage(){
    if (wageMode === 'direct'){
      var v = num('knWageDirect');
      var lim = calcWageMonthly(v / 30);
      return { mode:'direct', wageMonthly: lim.applied, limit: lim, raw: v };
    }
    var rows = readRows();
    var valid = pickValidMonths(rows);
    var daily = calcWageDaily(rows, valid, payType);
    var lim = calcWageMonthly(daily.daily);
    return { mode:'table', rows: rows, valid: valid, daily: daily, limit: lim, wageMonthly: lim.applied };
  }

  function renderWageTable(w){
    if (w.mode !== 'table') return;
    var trs = $('knWageRows').querySelectorAll('tr');
    for (var i = 0; i < trs.length; i++){
      var r = w.rows[i];
      var used = w.valid.indexOf(i) >= 0;
      trs[i].className = used ? '' : (r.partial ? 'kn-partial' : 'kn-excluded');
      trs[i].querySelector('.kn-cell-sum').textContent = plain(r.a + r.b);
      var flag = trs[i].querySelector('.kn-exflag');
      if (!used){
        flag.innerHTML = r.partial
          ? '<span class="kn-exbadge kn-exbadge-p">端数期間・算定対象外</span>'
          : (r.days < MIN_BASE_DAYS
              ? '<span class="kn-exbadge">基礎日数11日未満</span>'
              : '<span class="kn-exbadge">6か月分を満たしたため対象外</span>');
      } else { flag.innerHTML = '<span class="kn-usebadge">算定に使用</span>'; }
      // 労働日数欄は「日給・時給制」で変動給がある行だけ有効化
      var workIn = trs[i].querySelector('.kn-in-work');
      var needWork = w.daily.isDaily && r.b > 0;
      workIn.disabled = !needWork;
      workIn.style.opacity = needWork ? '1' : '.3';
    }
    $('knSumA').textContent    = plain(w.daily.sumFixed);
    $('knSumB').textContent    = plain(w.daily.sumVar);
    $('knSumWork').textContent = w.daily.hasB ? plain(w.daily.sumWork) + '日' : '—';
    $('knSumAll').textContent  = plain(w.daily.sumAll);
  }

  function renderWageResult(w){
    var box = $('knWageResult');
    var h = '<div class="kn-calcbox">';

    if (w.mode === 'direct'){
      h += '<div class="kn-calcline"><span class="kn-calclabel">入力した賃金月額</span><span class="kn-calcval">' + yen(w.raw) + '</span></div>';
    } else {
      if (w.daily.count < CALC_MONTHS){
        h += '<div class="kn-calcline" style="color:var(--kn-danger);"><span class="kn-calclabel">⚠ 算定できる月が不足</span>'
          +  '<span>基礎日数11日以上の月が' + w.daily.count + 'か月分しかありません。行を追加して6か月分入力してください。</span></div>';
      }
      var abNote = w.daily.isDaily
        ? '固定給はA欄、変動給はB欄として計算します（日給・時給制）。'
        : '固定給・変動給ともに「月によって定められた賃金」なので、まとめてA欄として計算します。';
      h += '<div class="kn-calcline"><span class="kn-calclabel">賃金証明書の欄</span><span>' + abNote + '</span></div>';
      h += '<div class="kn-calcline">'
        +   '<span class="kn-calclabel">原則の計算</span>'
        +   '<span class="kn-formula">' + (w.daily.isDaily
              ? '（A欄 ' + plain(w.daily.sumA) + ' ＋ B欄 ' + plain(w.daily.sumB) + '） ÷ 180'
              : 'A欄合計 ' + plain(w.daily.sumA) + ' ÷ 180') + '</span>'
        +   (w.daily.adopted === 'principle' ? '<span class="kn-adopted">採用</span>' : '')
        +   '<span class="kn-calcval">' + dec(w.daily.principle) + ' 円</span></div>';
      if (w.daily.guarantee !== null){
        h += '<div class="kn-calcline">'
          +   '<span class="kn-calclabel">最低保障の計算</span>'
          +   '<span class="kn-formula">' + plain(w.daily.sumA) + ' ÷ 180 ＋ ' + plain(w.daily.sumB) + ' ÷ ' + plain(w.daily.sumWork) + '日 × 70％</span>'
          +   (w.daily.adopted === 'guarantee' ? '<span class="kn-adopted">採用</span>' : '')
          +   '<span class="kn-calcval">' + dec(w.daily.guarantee) + ' 円</span></div>';
        h += '<div class="kn-calcline"><span class="kn-calclabel">賃金日額</span>'
          +  '<span class="kn-formula">高い方を採用</span>'
          +  '<span class="kn-calcval">' + dec(w.daily.daily) + ' 円</span></div>';
      }
      h += '<div class="kn-calcline"><span class="kn-calclabel">賃金月額</span>'
        +  '<span class="kn-formula">賃金日額 ' + dec(w.daily.daily) + ' × 30</span>'
        +  '<span class="kn-calcval">' + yen(w.limit.raw) + '</span></div>';
    }

    if (w.limit.capped){
      h += '<div class="kn-calcline"><span class="kn-calclabel">上限の適用</span><span class="kn-capbadge">上限あり</span>'
        +  '<span class="kn-formula">上限 ' + plain(KN_LIMITS.wageMonthlyMax) + ' 円</span>'
        +  '<span class="kn-calcval">' + yen(KN_LIMITS.wageMonthlyMax) + '</span></div>';
    }
    if (w.limit.floored){
      h += '<div class="kn-calcline"><span class="kn-calclabel">下限の適用</span><span class="kn-capbadge">下限あり</span>'
        +  '<span class="kn-formula">下限 ' + plain(KN_LIMITS.wageMonthlyMin) + ' 円</span>'
        +  '<span class="kn-calcval">' + yen(KN_LIMITS.wageMonthlyMin) + '</span></div>';
    }
    h += '</div>';
    h += '<div class="kn-final"><span class="kn-fl">この人の賃金月額（比較の基準）</span><span class="kn-fv">' + yen(w.wageMonthly) + '</span></div>';
    h += '<p class="kn-note-sm">給付金は、毎月の賃金がこの額の <strong>75％（' + yen(w.wageMonthly*0.75) + '）未満</strong> に下がったときに支給されます。</p>';
    box.innerHTML = h;
  }

  /* ===================================================================
     ③ 支給対象月の賃金
     =================================================================== */
  function getMonths(){
    var y = parseInt($('knMonthAY').value,10), m = parseInt($('knMonthAM').value,10);
    var a = { y:y, m:m };
    var by = y, bm = m+1; if (bm > 12){ bm = 1; by++; }
    return { a: a, b: { y:by, m:bm } };
  }
  function fmtYM(o){ return o.y + '年' + o.m + '月'; }

  function computeCommute(){
    var cyc = parseInt($('knCommuteCycle').value,10) || 0;
    var amt = num('knCommuteAmt');
    if (cyc <= 0 || amt <= 0) return { cycle:cyc, amount:amt, a:0, b:0, alloc:[], active:false };
    if (cyc === 1) return { cycle:1, amount:amt, a:amt, b:amt, alloc:[amt], active:true };
    var off = parseInt($('knCommuteOffset').value,10) || 0;
    var alloc = allocateCommute(amt, cyc);
    var ia = off % cyc;
    var ib = (off + 1) % cyc;
    return { cycle:cyc, amount:amt, alloc:alloc, a:alloc[ia], b:alloc[ib], ia:ia, ib:ib, active:true };
  }

  function renderCommute(c){
    var box = $('knCommuteResult');
    if (!c.active){ box.innerHTML = ''; return; }
    if (c.cycle === 1){
      box.innerHTML = '<div>毎月 ' + yen(c.amount) + ' を各支給対象月の賃金に含めて計算します。</div>';
      return;
    }
    var h = '<div><strong>' + c.cycle + 'か月分 ' + yen(c.amount) + '</strong> を1か月あたりに割り振ります（端数は最後の月に加算）。</div><div class="kn-alloc">';
    for (var i=0;i<c.alloc.length;i++){
      var mark = (i === c.ia) ? '【支給対象月A】' : (i === c.ib ? '【支給対象月B】' : '');
      var hit = mark ? ' kn-hit' : '';
      h += '<span class="' + hit.trim() + '">支給' + (i+1) + 'か月目' + mark + '：' + yen(c.alloc[i]) + '</span>';
    }
    h += '</div><div class="kn-note-sm">支給対象月A・Bの賃金に、それぞれ上記の額を加えて計算しています。</div>';
    box.innerHTML = h;
  }

  /* ===================================================================
     ④ 結果・計算過程
     =================================================================== */
  var STATUS_TEXT = {
    ok:        '',
    overLimit: '支払われた賃金が支給限度額（' + plain(KN_LIMITS.benefitLimit) + '円）以上のため不支給',
    ratio75:   '賃金の低下が75％未満に達していないため不支給',
    underMin:  '計算した額が最低限度額（' + plain(KN_LIMITS.benefitMin) + '円）以下のため不支給'
  };

  function renderSummary(w, ra, rb){
    var total = ra.amount + rb.amount;
    function card(cls, label, sub, r){
      var zero = r.amount <= 0;
      return '<div class="kn-sumcard ' + cls + '">'
        + '<div class="kn-sc-label">' + label + '</div>'
        + '<div class="kn-sc-sub">' + sub + '</div>'
        + '<div class="kn-sc-val' + (zero ? ' kn-zero' : '') + '">' + (zero ? '不支給' : yen(r.amount)) + '</div>'
        + '<div class="kn-sc-meta">賃金 ' + yen(r.paid) + '／低下率 ' + dec(r.ratio) + '％／支給率 ' + dec(r.rate) + '％</div>'
        + '</div>';
    }
    var m = getMonths();
    var h = card('', '1か月目の給付金', fmtYM(m.a), ra)
          + card('kn-b', '2か月目の給付金', fmtYM(m.b), rb)
          + '<div class="kn-sumcard kn-tot"><div class="kn-sc-label">2か月分の振込額</div>'
          + '<div class="kn-sc-sub">' + fmtYM(m.a) + '＋' + fmtYM(m.b) + '</div>'
          + '<div class="kn-sc-val' + (total<=0 ? ' kn-zero' : '') + '">' + (total<=0 ? '不支給' : yen(total)) + '</div>'
          + '<div class="kn-sc-meta">原則2か月に1回まとめて支給されます</div></div>';
    $('knSummary').innerHTML = h;
  }

  function renderSteps(w, ra){
    var kind = ra.kind, r = KN_RATE_RULES[kind];
    var m = getMonths();
    var steps = [];

    // STEP1 賃金月額
    var s1 = '<div class="kn-step-body">60歳到達日より前の6か月間に支払われた賃金から、比較の基準となる「賃金月額」を出します。';
    if (w.mode === 'table'){
      s1 += '<div class="kn-eq">賃金日額 ＝ ' + (w.daily.adopted === 'guarantee'
        ? plain(w.daily.sumA) + ' ÷ 180 ＋ ' + plain(w.daily.sumB) + ' ÷ ' + plain(w.daily.sumWork) + ' × 0.7 ＝ <span class="kn-eq-r">' + dec(w.daily.daily) + ' 円</span>（最低保障）'
        : plain(w.daily.sumAll) + ' ÷ 180 ＝ <span class="kn-eq-r">' + dec(w.daily.daily) + ' 円</span>')
        + '<br>賃金月額 ＝ ' + dec(w.daily.daily) + ' × 30 ＝ <span class="kn-eq-r">' + yen(w.limit.raw) + '</span></div>';
    }
    if (w.limit.capped)  s1 += '<div class="kn-step-note">上限' + plain(KN_LIMITS.wageMonthlyMax) + '円を超えるため、賃金月額は上限額になります。</div>';
    if (w.limit.floored) s1 += '<div class="kn-step-note">下限' + plain(KN_LIMITS.wageMonthlyMin) + '円を下回るため、賃金月額は下限額になります。</div>';
    s1 += '<div class="kn-eq">この人の賃金月額 ＝ <span class="kn-eq-r">' + yen(w.wageMonthly) + '</span><br>'
       +  '支給の判定ライン（賃金月額の75％） ＝ ' + plain(w.wageMonthly) + ' × 75％ ＝ <span class="kn-eq-r">' + yen(w.wageMonthly*0.75) + '</span></div>'
       +  '<div class="kn-step-note">60歳以降に支払われる賃金が、この <strong>' + yen(w.wageMonthly*0.75) + ' 未満</strong> に下がった月が給付金の対象になります。'
       +  'ちょうど75％（' + yen(w.wageMonthly*0.75) + '）だと対象になりません。</div></div>';
    steps.push({ t:'賃金月額（比較の基準）を出す', b:s1 });

    // STEP2 みなし賃金
    var s2 = '<div class="kn-step-body">' + fmtYM(m.a) + 'に実際に支払われた賃金は <strong>' + yen(ra.paid) + '</strong> です。';
    if (ra.cut > 0){
      s2 += '欠勤等による減額が ' + yen(ra.cut) + ' あるため、低下率の判定にはこれを足し戻した「みなし賃金」を使います。'
         +  '<div class="kn-eq">みなし賃金 ＝ ' + plain(ra.paid) + ' ＋ ' + plain(ra.cut) + ' ＝ <span class="kn-eq-r">' + yen(ra.deemed) + '</span></div>'
         +  '<div class="kn-step-note">給付金を掛ける相手は、あくまで実際に支払われた賃金（' + yen(ra.paid) + '）です。</div>';
    } else {
      s2 += '欠勤等による減額はないので、みなし賃金も同額です。';
    }
    s2 += '</div>';
    steps.push({ t:'みなし賃金を出す', b:s2 });

    // STEP3 低下率
    var s3 = '<div class="kn-step-body">賃金月額に対して、いま何％の水準かを計算します。'
      + '<div class="kn-eq">低下率 ＝ ' + plain(ra.deemed) + ' ÷ ' + plain(ra.wageMonthly) + ' × 100 ＝ <span class="kn-eq-r">' + dec(ra.ratio) + ' ％</span></div>'
      + '<div class="kn-step-note">小数点以下第3位を四捨五入して第2位まで求めます。75％以上だと支給されません。</div></div>';
    steps.push({ t:'低下率を出す', b:s3, ng: ra.status === 'ratio75' });

    // STEP4 支給率
    var s4 = '<div class="kn-step-body">';
    if (ra.status === 'ratio75'){
      s4 += '低下率が75％以上なので、<strong>給付金は支給されません</strong>。賃金が賃金月額の75％未満に下がって初めて対象になります。';
    } else if (ra.status === 'overLimit'){
      s4 += '支払われた賃金が支給限度額（' + plain(KN_LIMITS.benefitLimit) + '円）以上のため、<strong>給付金は支給されません</strong>。';
    } else if (ra.rateBranch === 'flat'){
      s4 += '低下率が' + r.flatUpTo + '％以下なので、支給率は上限の <strong>' + r.max + '％</strong> です。'
         +  '<div class="kn-eq">支給率 ＝ <span class="kn-eq-r">' + dec(ra.rate) + ' ％</span></div>';
    } else {
      s4 += '低下率が' + r.flatUpTo + '％を超えて75％未満なので、次の式で支給率を求めます。'
         +  '<div class="kn-eq">支給率 ＝ （' + r.a + ' × X ＋ ' + plain(r.b) + '） ÷ ' + r.d + ' × 100 ÷ X　（X＝低下率）<br>'
         +  '　　　 ＝ （' + r.a + ' × ' + dec(ra.ratio) + ' ＋ ' + plain(r.b) + '） ÷ ' + r.d + ' × 100 ÷ ' + dec(ra.ratio) + '<br>'
         +  '　　　 ＝ <span class="kn-eq-r">' + dec(ra.rate) + ' ％</span></div>'
         +  '<div class="kn-step-note">低下率が75％に近いほど支給率は0％に近づき、' + r.flatUpTo + '％以下で上限の' + r.max + '％になります。</div>';
    }
    s4 += '</div>';
    steps.push({ t:'支給率を出す（区分：' + r.label + '）', b:s4, ng: (ra.status === 'ratio75' || ra.status === 'overLimit') });

    // STEP5 支給額
    var s5 = '<div class="kn-step-body">';
    if (ra.status === 'ratio75' || ra.status === 'overLimit'){
      s5 += '<strong>' + STATUS_TEXT[ra.status] + '</strong>';
    } else {
      s5 += '実際に支払われた賃金に支給率を掛けます（小数点以下切り捨て）。'
         +  '<div class="kn-eq">支給額 ＝ ' + plain(ra.paid) + ' × ' + dec(ra.rate) + '％ ＝ <span class="kn-eq-r">' + yen(ra.raw) + '</span></div>';
      if (ra.capped){
        s5 += '<div class="kn-step-note">賃金と給付金の合計が支給限度額' + plain(KN_LIMITS.benefitLimit) + '円を超えるため、'
           +  plain(KN_LIMITS.benefitLimit) + ' − ' + plain(ra.paid) + ' ＝ <strong>' + yen(ra.cappedAmount) + '</strong> に調整されます。</div>';
      }
      if (ra.status === 'underMin'){
        s5 += '<div class="kn-step-note" style="color:var(--kn-danger);"><strong>' + STATUS_TEXT.underMin + '</strong></div>';
      } else {
        s5 += '<div class="kn-eq">' + fmtYM(m.a) + 'の給付金 ＝ <span class="kn-eq-r">' + yen(ra.amount) + '</span></div>';
      }
    }
    s5 += '</div>';
    steps.push({ t:'支給額を出す', b:s5, ng: ra.amount <= 0 });

    var h = '';
    for (var i=0;i<steps.length;i++){
      h += '<div class="kn-step' + (steps[i].ng ? ' kn-ng' : '') + '">'
        +  '<div class="kn-step-head"><span class="kn-step-no">' + (i+1) + '</span><span class="kn-step-title">' + steps[i].t + '</span></div>'
        +  steps[i].b + '</div>';
    }
    $('knSteps').innerHTML = h;
  }

  function renderSchedule(ra, rb){
    var m = getMonths();
    var total = ra.amount + rb.amount;
    function row(label, r){
      return '<tr><td>' + label + '</td><td class="kn-num">' + yen(r.paid) + '</td><td class="kn-num">' + dec(r.ratio) + '％</td>'
           + '<td class="kn-num">' + dec(r.rate) + '％</td><td class="kn-num">' + (r.amount>0 ? yen(r.amount) : '不支給') + '</td></tr>';
    }
    var h = '<table><thead><tr><th>支給対象月</th><th style="text-align:right;">支払われた賃金</th><th style="text-align:right;">低下率</th><th style="text-align:right;">支給率</th><th style="text-align:right;">給付金</th></tr></thead><tbody>'
      + row(fmtYM(m.a), ra) + row(fmtYM(m.b), rb)
      + '<tr class="kn-total"><td>2か月分の振込額</td><td colspan="3"></td><td class="kn-num">' + (total>0 ? yen(total) : '不支給') + '</td></tr>'
      + '</tbody></table>'
      + '<p class="kn-sched-note">給付金は原則2か月に1回、2か月分をまとめて指定の口座に振り込まれます。'
      + '月ごとに支払われた賃金が違えば、低下率・支給率も月ごとに変わります。</p>';
    $('knSchedule').innerHTML = h;
  }

  /* ===================================================================
     ⑥ 年金との併給調整
     =================================================================== */
  function initPensionForm(){
    $('knPension').innerHTML =
      '<div id="knPenJudge"></div>'
      + '<div class="kn-pension-form kn-hidden" id="knPenForm">'
      +   '<div class="kn-field"><label for="knPenAnnual">特別支給の老齢厚生年金（報酬比例部分）の年額</label>'
      +     '<div class="kn-inputrow"><input type="number" id="knPenAnnual" value="1200000" step="10000" min="0" /><span class="kn-unit">円</span></div>'
      +     '<span class="kn-hint">ねんきん定期便などに記載の年額</span></div>'
      +   '<div class="kn-field"><label for="knPenStd">標準報酬月額</label>'
      +     '<div class="kn-inputrow"><input type="number" id="knPenStd" value="260000" step="1000" min="0" /><span class="kn-unit">円</span></div>'
      +     '<span class="kn-hint">厚生年金の等級に対応する月額</span></div>'
      +   '<div class="kn-field"><label for="knPenBonus">直近1年間の賞与（標準賞与額の合計）</label>'
      +     '<div class="kn-inputrow"><input type="number" id="knPenBonus" value="0" step="10000" min="0" /><span class="kn-unit">円</span></div>'
      +     '<span class="kn-hint">在職老齢年金の判定に使います</span></div>'
      + '</div>'
      + '<div id="knPenResult"></div>';
    ['knPenAnnual','knPenStd','knPenBonus'].forEach(function(id){
      var e = $(id);
      if (e){ e.addEventListener('input', updateAll); e.addEventListener('change', updateAll); }
    });
  }

  function renderPension(w, ra){
    var birth = $('knBirth').value;
    var j = judgeTokubetsu(birth, gender);
    var judge = $('knPenJudge'), form = $('knPenForm'), res = $('knPenResult');

    if (!j.eligible){
      form.classList.add('kn-hidden');
      res.innerHTML = '';
      var msg = (gender === 'male')
        ? '<strong>男性は昭和36年4月2日以降生まれの方から特別支給の老齢厚生年金がありません。</strong>いま60〜65歳の男性はすべてこの区分に入るため、高年齢雇用継続給付を受けても年金が減ることはありません（老齢厚生年金は65歳から）。'
        : '<strong>女性は昭和41年4月2日以降生まれの方から特別支給の老齢厚生年金がありません。</strong>老齢厚生年金は65歳からのため、高年齢雇用継続給付との併給調整は起こりません。';
      judge.innerHTML = '<div class="kn-pen-none">' + msg + '</div>';
      return;
    }

    var startAt = reachDate(birth, j.age);
    var payFrom = new Date(startAt.getFullYear(), startAt.getMonth()+1, 1);   // 年齢到達月の翌月分から
    judge.innerHTML = '<div class="kn-result-strip">'
      + '<div><strong>特別支給の老齢厚生年金の対象です</strong>（' + (gender==='male'?'男性':'女性') + '・' + j.age + '歳から）</div>'
      + '<div>' + j.age + '歳到達日：' + fmtDate(startAt) + '　→　年金は <strong>' + payFrom.getFullYear() + '年' + (payFrom.getMonth()+1) + '月分</strong> から65歳到達月まで</div>'
      + '<div class="kn-hint">この年金を受けながら高年齢雇用継続給付を受けると、年金の一部が支給停止されます。</div></div>';
    form.classList.remove('kn-hidden');

    var annual = num('knPenAnnual');
    var std    = num('knPenStd');
    var bonus  = num('knPenBonus');
    var basic  = Math.floor(annual / 12);
    var totalReward = std + Math.floor(bonus / 12);

    var z = calcZaishoku(basic, totalReward);
    var c = calcPensionCoordination(std, w.wageMonthly, ra.kind, ra.amount > 0);
    var net = Math.max(0, basic - z.stop - c.amount);

    var h = '<div class="kn-stack">';
    h += '<div class="kn-stackrow"><span class="kn-sr-label">基本月額（報酬比例部分の月額）</span><span class="kn-sr-val">' + yen(basic) + '</span>'
      +  '<span class="kn-sr-formula">年金の年額 ' + plain(annual) + ' ÷ 12 ＝ ' + plain(basic) + ' 円</span></div>';
    h += '<div class="kn-stackrow"><span class="kn-sr-label">総報酬月額相当額</span><span class="kn-sr-val">' + yen(totalReward) + '</span>'
      +  '<span class="kn-sr-formula">標準報酬月額 ' + plain(std) + ' ＋ 直近1年間の標準賞与額 ' + plain(bonus) + ' ÷ 12 ＝ ' + plain(totalReward) + ' 円</span></div>';

    // ① 在職老齢年金による支給停止
    h += '<div class="kn-stackrow' + (z.stop > 0 ? ' kn-minus' : '') + '">'
      +  '<span class="kn-sr-label">① 在職老齢年金による停止</span>'
      +  '<span class="kn-sr-val">' + (z.stop > 0 ? '− ' + yen(z.stop) : '停止なし') + '</span>'
      +  '</div>';
    h += '<div class="kn-rulebox">'
      +  '<div class="kn-rule-title">制度上の計算式</div>'
      +  '<div class="kn-rule-eq">支給停止額 ＝ （総報酬月額相当額 ＋ 基本月額 − 支給停止調整額） ÷ 2</div>'
      +  '<div class="kn-rule-note">'
      +    '総報酬月額相当額 ＝ 標準報酬月額 ＋ 直近1年間の標準賞与額 ÷ 12<br>'
      +    '基本月額 ＝ 老齢厚生年金（報酬比例部分）の年額 ÷ 12<br>'
      +    '支給停止調整額 ＝ <strong>' + plain(z.threshold) + ' 円</strong>（' + KN_ZAIROU.label + '。令和7年度の510,000円から引き上げ）<br>'
      +    '合計が支給停止調整額以下なら停止はなく、超えた分の半額が停止されます。'
      +  '</div>'
      +  '<div class="kn-rule-title">この人にあてはめると</div>'
      +  '<div class="kn-rule-eq">'
      +    '総報酬月額相当額 ' + plain(totalReward) + ' ＋ 基本月額 ' + plain(basic) + ' ＝ ' + plain(z.sum) + ' 円<br>'
      +    (z.over
          ? '（' + plain(z.sum) + ' − ' + plain(z.threshold) + '） ÷ 2 ＝ <span class="kn-eq-r">' + plain(z.stop) + ' 円が停止</span>'
              + (z.stop >= basic ? '<br><span class="kn-rule-cap">※ 停止額が基本月額を超えるため、年金は全額停止になります</span>' : '')
          : plain(z.sum) + ' ≦ 支給停止調整額 ' + plain(z.threshold) + ' 円　→　<span class="kn-eq-r">支給停止なし（全額支給）</span>')
      +  '</div>'
      +  '</div>';

    // ② 雇用継続給付との調整
    var cText, cFormula;
    if (c.branch === 'noBenefit'){
      cText = '調整なし';
      cFormula = '高年齢雇用継続給付が支給されない月なので、<span class="kn-eq-r">併給調整は行われません</span>。';
    } else if (c.branch === 'overLimit'){
      cText = '調整なし';
      cFormula = '標準報酬月額 ' + plain(std) + ' 円 ≧ 支給限度額 ' + plain(KN_LIMITS.benefitLimit) + ' 円　→　<span class="kn-eq-r">調整なし</span>';
    } else if (c.branch === 'over75'){
      cText = '調整なし';
      cFormula = '標準報酬月額 ' + plain(std) + ' ÷ 賃金月額 ' + plain(w.wageMonthly) + ' × 100 ＝ ' + dec(c.z) + '％（75％以上）　→　<span class="kn-eq-r">調整なし</span>';
    } else if (c.branch === 'max'){
      cText = '− ' + yen(c.amount);
      cFormula = '標準報酬月額 ' + plain(std) + ' ÷ 賃金月額 ' + plain(w.wageMonthly) + ' × 100 ＝ ' + dec(c.z) + '％（' + KN_RATE_RULES[ra.kind].flatUpTo + '％以下）<br>'
        + '停止率は上限の ' + dec(c.rate) + '％<br>'
        + plain(std) + ' × ' + dec(c.rate) + '％ ＝ <span class="kn-eq-r">' + plain(c.amount) + ' 円が停止</span>';
    } else {
      cText = '− ' + yen(c.amount);
      cFormula = '標準報酬月額 ' + plain(std) + ' ÷ 賃金月額 ' + plain(w.wageMonthly) + ' × 100 ＝ ' + dec(c.z) + '％<br>'
        + '停止率 ＝ 支給率 ' + dec(c.baseRate) + '％ × 0.4 ＝ ' + dec(c.rate) + '％<br>'
        + plain(std) + ' × ' + dec(c.rate) + '％ ＝ <span class="kn-eq-r">' + plain(c.amount) + ' 円が停止</span>';
    }
    h += '<div class="kn-stackrow' + (c.amount > 0 ? ' kn-minus' : '') + '">'
      +  '<span class="kn-sr-label">② 高年齢雇用継続給付との調整</span>'
      +  '<span class="kn-sr-val">' + cText + '</span></div>';
    h += '<div class="kn-rulebox">'
      +  '<div class="kn-rule-title">制度上の計算式</div>'
      +  '<div class="kn-rule-eq">支給停止額 ＝ 標準報酬月額 × 支給停止率</div>'
      +  '<div class="kn-rule-note">'
      +    '標準報酬月額が60歳到達時の賃金月額の ' + KN_RATE_RULES[ra.kind].flatUpTo + '％以下 → 停止率は上限の ' + KN_RATE_RULES[ra.kind].pensionMax + '％<br>'
      +    '同じく ' + KN_RATE_RULES[ra.kind].flatUpTo + '％超75％未満 → 停止率 ＝ 高年齢雇用継続給付の支給率 × 0.4<br>'
      +    '同じく75％以上、または標準報酬月額が支給限度額 ' + plain(KN_LIMITS.benefitLimit) + ' 円以上 → 調整なし'
      +  '</div>'
      +  '<div class="kn-rule-title">この人にあてはめると</div>'
      +  '<div class="kn-rule-eq">' + cFormula + '</div>'
      +  '</div>';

    h += '<div class="kn-stackrow kn-net"><span class="kn-sr-label">実際に受け取れる年金（月額）</span>'
      +  '<span class="kn-sr-val">' + yen(net) + '</span>'
      +  '<span class="kn-sr-formula">' + plain(basic) + ' − ' + plain(z.stop) + ' − ' + plain(c.amount) + ' ＝ ' + plain(net) + ' 円</span></div>';

    var handIn = net + ra.paid + ra.amount;
    h += '<div class="kn-stackrow"><span class="kn-sr-label">賃金＋給付金＋年金の合計（月額の目安）</span>'
      +  '<span class="kn-sr-val">' + yen(handIn) + '</span>'
      +  '<span class="kn-sr-formula">賃金 ' + plain(ra.paid) + ' ＋ 給付金 ' + plain(ra.amount) + ' ＋ 年金 ' + plain(net) + '（額面・社会保険料や税は控除前）</span></div>';
    h += '</div>';
    res.innerHTML = h;
  }

  /* ===================================================================
     前提条件
     =================================================================== */
  function renderAssumptions(w, ra){
    var r = KN_RATE_RULES[ra.kind];
    var items = [
      '支給率の区分：' + r.label + '（低下率' + r.flatUpTo + '％以下で上限' + r.max + '％）',
      '賃金月額の上限 ' + plain(KN_LIMITS.wageMonthlyMax) + '円／下限 ' + plain(KN_LIMITS.wageMonthlyMin) + '円（' + KN_LIMITS.label + '適用）',
      '支給限度額 ' + plain(KN_LIMITS.benefitLimit) + '円／最低限度額 ' + plain(KN_LIMITS.benefitMin) + '円（毎年8月1日に改定されます）',
      '在職老齢年金の支給停止調整額 ' + plain(KN_ZAIROU.threshold) + '円（' + KN_ZAIROU.label + '）',
      '低下率・支給率は小数点以下第3位を四捨五入、支給額は小数点以下を切り捨てて計算しています',
      '支給対象月は暦月の初日から末日まで被保険者である月です。育児休業給付・介護休業給付を受けた月は対象になりません'
    ];
    var h = '';
    for (var i=0;i<items.length;i++) h += '<li>' + items[i] + '</li>';
    $('knAssumptions').innerHTML = h;
  }

  /* ===================================================================
     再描画
     =================================================================== */
  function updateAll(){
    renderEligibility();

    var w = computeWage();
    if (w.mode === 'table') renderWageTable(w);
    renderWageResult(w);

    var c = computeCommute();
    renderCommute(c);

    var m = getMonths();
    $('knMonthBLabel').textContent = fmtYM(m.b);
    $('knMcLabelA').textContent = fmtYM(m.a);
    $('knMcLabelB').textContent = fmtYM(m.b);

    var kind = getRateKind();
    var ra = calcBenefitMonth({ paid: num('knMaBase') + num('knMaVar') + c.a, cut: num('knMaCut'), wageMonthly: w.wageMonthly, kind: kind });
    var rb = calcBenefitMonth({ paid: num('knMbBase') + num('knMbVar') + c.b, cut: num('knMbCut'), wageMonthly: w.wageMonthly, kind: kind });

    renderSummary(w, ra, rb);
    renderSteps(w, ra);
    renderSchedule(ra, rb);
    renderPension(w, ra);
    renderAssumptions(w, ra);
  }

  /* ===================================================================
     イベント
     =================================================================== */
  function bindPills(wrapId, cb){
    var wrap = $(wrapId);
    wrap.querySelectorAll('label').forEach(function(lb){
      lb.addEventListener('click', function(){
        wrap.querySelectorAll('label').forEach(function(x){ x.classList.remove('kn-on'); });
        lb.classList.add('kn-on');
        var input = lb.querySelector('input');
        if (input){ input.checked = true; cb(input.value); }
      });
    });
  }

  function init(){
    // 生年月日の初期値は「今日の60年前」。静的サイトなのでビルド日ではなく表示時点で計算する
    var t = new Date();
    $('knBirth').value = isoOf(new Date(t.getFullYear()-60, t.getMonth(), t.getDate()));
    initSelects();
    initPensionForm();
    renderCommuteOffset();
    buildWageRows();

    bindPills('knGender', function(v){ gender = v; updateAll(); });
    bindPills('knRateMode', function(v){ rateMode = v; updateAll(); });

    $('knWageTabs').querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){
        $('knWageTabs').querySelectorAll('button').forEach(function(x){ x.classList.remove('kn-on'); });
        b.classList.add('kn-on');
        wageMode = b.getAttribute('data-tab');
        $('knPaneTable').classList.toggle('kn-hidden', wageMode !== 'table');
        $('knPaneDirect').classList.toggle('kn-hidden', wageMode !== 'direct');
        updateAll();
      });
    });

    ['change','input'].forEach(function(ev){
      $('knBirth').addEventListener(ev, function(){ buildWageRows(); updateAll(); });
    });
    $('knCutoff').addEventListener('change', function(){ buildWageRows(); updateAll(); });
    $('knPayType').addEventListener('change', function(){
      payType = $('knPayType').value;
      $('knThVar').textContent = (payType === 'daily')
        ? '日給・時給・歩合給・時間外手当'
        : '時間外手当・休日手当';
      buildWageRows(); updateAll();
    });

    $('knAddRow').addEventListener('click', function(){
      if (rowCount >= 13) return;
      rowCount++; buildWageRows(); updateAll();
      if (rowCount >= 13) $('knAddRow').disabled = true;
    });
    $('knFillAll').addEventListener('click', function(){
      var trs = $('knWageRows').querySelectorAll('tr');
      if (!trs.length) return;
      // 端数期間ではない最初の行（＝最初の完全な賃金月）を基準にする
      var src = 0;
      while (src < trs.length && trs[src].getAttribute('data-partial') === '1') src++;
      if (src >= trs.length) return;
      var a = trs[src].querySelector('.kn-in-a').value;
      var b = trs[src].querySelector('.kn-in-b').value;
      var d = trs[src].querySelector('.kn-in-days').value;
      var wk = trs[src].querySelector('.kn-in-work').value;
      for (var i=src+1;i<trs.length;i++){
        trs[i].querySelector('.kn-in-a').value = a;
        trs[i].querySelector('.kn-in-b').value = b;
        trs[i].querySelector('.kn-in-days').value = d;
        trs[i].querySelector('.kn-in-work').value = wk;
      }
      updateAll();
    });

    $('knCommuteCycle').addEventListener('change', function(){ renderCommuteOffset(); updateAll(); });

    ['knInsured','knWageDirect','knMonthAY','knMonthAM','knMaBase','knMaVar','knMaCut',
     'knMbBase','knMbVar','knMbCut','knCommuteAmt','knCommuteOffset'].forEach(function(id){
      var e = $(id); if (!e) return;
      e.addEventListener('input', updateAll);
      e.addEventListener('change', updateAll);
    });

    $('knPrintBtn').addEventListener('click', function(){
      var emp = ($('knEmpName').value || '').trim();
      var co  = ($('knCoName').value || '').trim();
      var w = computeWage();
      var m = getMonths();
      $('knPhEmployee').textContent = emp || '________________';
      $('knPhCompany').textContent  = co;
      $('knPhMeta').textContent = '賃金月額 ' + plain(w.wageMonthly) + '円 ／ 対象月 ' + fmtYM(m.a) + '・' + fmtYM(m.b)
        + ' ／ 作成日 ' + fmtDate(new Date());
      window.print();
    });

    updateAll();
  }

  init();
})();
</script>
