---
import Layout from '../layouts/Layout.astro';

// 事務所サイトのトップ（2026-09-12 全面改修）。
//
// 軸の置き方：
//   商品        … 顧問契約。会社の事情を知り、日々の労務判断を続けて支える
//   選ばれる理由 … 両立支援・健康経営の資格と、県からの依頼実績、制度を運用する側の経験
//   入口        … 「なぜその制度なのか」を社員に説明できる会社にする
//
// AI・RPA・小さな専門家の話はここでは主役にしない。そちらは小さな専門家.jp に任せる。
// 差別化（かつては AI、いまは両立支援）を商品そのものにすると、何屋か分からなくなる。
// 両立支援は単発の依頼になりやすく、事務所が欲しいのは顧問先なので、
// 両立支援は「顧問を選ぶ理由」として置く。
//
// 書かないと決めたもの：家族の事情（実名と並べると誰の健康状態か特定される）、
// 対応する曜日・時間帯（書けば守る義務が生じる）、「11,000円〜」の前面掲出。

// こんな場面でご相談ください。両立支援を制度の説明ではなく、経営者の判断場面で見せる
const scenes = [
  { title: '親の介護で、働き方を変えたいと言われた', body: '本人の希望と、現場の人員配置と、周囲の社員の負担。三つを同時に見ないと決められません。' },
  { title: '治療を続けながら働く社員の勤務を、どう調整するか', body: '通院の頻度も体調も変わります。一度決めて終わりではなく、見直しの前提で組みます。' },
  { title: '男性社員が育休を取る。引き継ぎと周囲をどうするか', body: '制度はあっても、取れる空気と段取りがなければ使われません。' },
  { title: '就業規則はあるが、実際の運用と合っていない', body: '規程と現場のずれは、裁判になっていないから問題になっていないだけ、ということがよくあります。' },
  { title: '手当や休暇の理由を、社員にきちんと説明できない', body: '「なぜその手当か」を答えられない制度は、不公平に見えた瞬間に信頼を失います。' },
];

// お手伝いできること。3本に絞る
const services = [
  {
    title: '両立支援の制度と運用',
    lead: '育児・介護・治療と、仕事を続けること。',
    body: '相談窓口の置き方、勤務制度と休暇、休職から復職までの流れ。社員本人への配慮と、周囲の負担と、事業の継続を、いっしょに見て整えます。2026年4月から、治療と仕事の両立支援は事業主の努力義務になりました。',
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  },
  {
    title: '就業規則と関連制度の整備',
    lead: '「なぜその制度なのか」を、説明できる規程に。',
    body: '手当・休暇・賃金の一つひとつに理由があるか。法令に合い、目的に合い、扱いに一貫性があり、現場で続けられるか。作ることより、説明できることを優先します。法改正への対応も含みます。',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    title: '継続的な労務相談（顧問）',
    lead: '日々の判断を、会社の事情を知ったうえで。',
    body: '労働時間、休暇、社員への対応、規則の運用。判断が必要な場面は毎月出てきます。一度きりの制度整備ではなく、会社の経緯を知っている相手に次も相談できる、という形で支えます。',
    icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
  },
];

// 顧問契約の2つの形。料金は料金表へ。ここでは金額を出さない
const retainers = [
  {
    name: '手続き＋相談顧問',
    who: '社会保険の手続きも、判断も、まとめて任せたい会社に',
    items: ['入退社・保険の手続き代行', '労務相談', '就業規則の運用と見直し'],
  },
  {
    name: '相談顧問',
    who: '社内に手続き担当者がいて、判断だけを外部に相談したい会社に',
    items: ['労務相談', '就業規則の運用と見直し', '休職・復職などの個別対応の整理'],
  },
];

// 顧問の進め方。「相談できます」だけでは毎月払う理由にならないので、何が起きるかを書く
const steps = [
  { title: '契約開始時', body: '会社の状況、いまの規則、抱えている課題を確認し、整える順番を決めます。' },
  { title: '相談のたびに', body: '法的な制約、取り得る選択肢、現場への影響、判断の理由を整理してお返しします。' },
  { title: '定期的に', body: '決めた対応が機能しているか、次に整える制度は何かを見直します。' },
];

// なぜこの事務所か。資格を並べるのではなく、顧問で何に生きるかに翻訳する
const reasons = [
  { label: '愛知働き方改革推進支援センター　専門家', body: '中小企業の制度づくりと運用を、公的な支援の場で担当しています。' },
  { label: '愛知県男性育児休業取得促進アドバイザー', body: '男性育休を「制度がある」から「実際に取れる」へ進める支援を、県の事業で行っています。' },
  { label: '愛知県治療と仕事の両立支援アドバイザー', body: '治療を続けながら働く社員への対応を、県の事業で企業に助言しています。2026年4月に努力義務となった領域です。' },
  { label: '両立支援コーディネーター／健康経営エキスパートアドバイザー', body: '治療と仕事の両立、育児・介護との両立を、会社全体の方針と体制につなげます。健康経営優良法人2026では、これらの両立支援が評価項目に加わりました。' },
  { label: '企業の役員・管理職としての実務', body: '制度を作る側だけでなく、運用する側にいます。人員配置、管理職の負担、費用。現場で回るかどうかを、その目で見ます。' },
];

// よくあるご質問（表示と FAQPage スキーマで共用）
const faqs = [
  {
    q: '社員が何人からお願いできますか？',
    a: '規模は問いません。中心にしているのは従業員10〜49人程度の会社です。社内に手続きの担当者がいて、難しい判断だけを外部に相談したい場合は「相談顧問」が向いています。',
  },
  {
    q: '一人の社員への対応だけでも相談できますか？',
    a: 'できます。まずその対応を整理するところから始め、同じ相談が次に来たときに困らないよう、制度と運用を整えるところまで進めます。',
  },
  {
    q: '就業規則はあります。運用だけ相談できますか？',
    a: 'できます。規程と実際の運用にずれがある、判断の基準が共有されていない、という相談は多くあります。既存の規則の解釈と運用は顧問の範囲で、新規作成や大幅な改定は別途お見積りします。',
  },
  {
    q: '治療と仕事の両立支援は、何から始めればよいですか？',
    a: '2026年4月から事業主の努力義務になりました。相談窓口をはっきりさせること、管理職への周知、勤務制度の確認。この順で、会社の規模に合う形を整えます。',
  },
  {
    q: '健康経営優良法人の認定を目指しています。',
    a: '2026年の認定要件に、育児・介護との両立支援や、治療と仕事の両立が評価項目として加わりました。両立支援コーディネーターと健康経営エキスパートアドバイザーの両方の立場から、認定に向けた体制づくりをお手伝いします。',
  },
  {
    q: '費用はどれくらいかかりますか？',
    a: '顧問料は、会社の規模と契約の形で決まります。目安は料金表をご覧ください。契約前に必ずお見積りします。初回のご相談は無料です。',
  },
  {
    q: '連絡はどのように取れますか？',
    a: 'お問い合わせフォームとメールで受け付けています。受付後、原則2営業日以内に一次回答をお返しします。調査が必要なご相談は、その旨と目安をお伝えします。面談はオンラインと対面のどちらにも対応します。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  fullTitle="おびかわ社労士事務所｜名古屋の労務顧問。両立支援を入口に、社員に説明できる制度を"
  description="名古屋の社労士事務所。育児・介護・治療と仕事の両立支援を入口に、社員に説明できる制度と現場で回る運用を、顧問として続けて支えます。従業員10〜49人の会社を中心に。"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ===== HERO ===== -->
  <section class="relative min-h-[92vh] bg-primary-900 flex items-center overflow-hidden">

    <div class="hero-fade absolute inset-0 opacity-[0.04]">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="hero-grid" width="64" height="64" patternUnits="userSpaceOnUse">
            <path d="M 64 0 L 0 0 0 64" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#hero-grid)"/>
      </svg>
    </div>
    <div class="hero-fade absolute top-0 right-0 h-full w-[45%] opacity-20"
         style="background: linear-gradient(135deg, transparent 30%, #1e3970 30%);"></div>
    <div class="hero-fade absolute top-[15%] bottom-[15%] right-[35%] w-px bg-accent-500/30 hidden lg:block"></div>

    <div class="relative max-w-5xl mx-auto px-6 lg:px-8 py-28 lg:py-36 w-full">
      <div class="max-w-2xl">

        <div class="hero-line-1 flex items-center gap-3 mb-8">
          <div class="w-8 h-px bg-accent-500"></div>
          <p class="text-accent-400 text-xs font-semibold tracking-[0.3em] uppercase">Obikawa SR Office</p>
        </div>

        <h1 class="hero-line-2 font-display font-bold text-white leading-[1.25] mb-6"
            style="font-size: clamp(2.2rem, 5vw, 3.8rem);">
          日々の労務判断に、<br/>
          <em class="not-italic text-accent-400">会社の事情を知る相談相手</em>を。
        </h1>

        <div class="hero-line-3 w-14 h-0.5 bg-accent-500 mb-6"></div>

        <p class="hero-line-3 text-primary-200 text-lg sm:text-xl leading-loose mb-10 max-w-xl">
          日常の労務相談から、就業規則の運用、休職・復職、育児・介護・治療との両立まで。<br class="hidden sm:block"/>
          経営と現場の事情を整理し、<span class="text-white font-semibold">社員に説明できる判断と制度づくり</span>を、顧問として続けて支えます。
        </p>

        <div class="hero-line-4 flex flex-col sm:flex-row gap-4">
          <a href="/contact/"
             class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-400 text-white font-bold px-8 py-4 transition-colors duration-200">
            顧問契約について相談する
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#services"
             class="inline-flex items-center justify-center gap-2 border border-primary-600 text-primary-300 hover:border-accent-500 hover:text-accent-400 font-semibold px-8 py-4 transition-colors duration-200">
            支援内容を見る
          </a>
        </div>

      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
      <span class="text-primary-500 text-[10px] tracking-[0.25em] font-semibold">SCROLL</span>
      <div class="scroll-bar w-px h-8 bg-accent-500"></div>
    </div>

  </section>


  <!-- ===== こんな場面でご相談ください ===== -->
  <section id="support" class="py-24 px-4 bg-warm-50">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Scenes</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">こんな場面で、<br class="sm:hidden"/>ご相談ください。</h2>
        <p class="mt-4 text-primary-500 text-base max-w-2xl">
          制度の名前より先に、判断に迷う場面から。どれも、本人の事情と、周囲の負担と、会社の運営を同時に見ないと決められないものです。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {scenes.map((s, i) => (
          <div class="bg-white border border-warm-200 p-7 flex gap-5">
            <span class="font-display text-3xl font-bold text-accent-500 leading-none shrink-0 w-10">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-bold text-primary-900 text-lg mb-2 leading-snug">{s.title}</h3>
              <p class="text-sm text-primary-600 leading-relaxed">{s.body}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ===== お手伝いできること ===== -->
  <section id="services" class="py-24 px-4 bg-white">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Services</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">お手伝いできること</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {services.map((s) => (
          <div class="border border-warm-200 p-8 flex flex-col">
            <div class="w-12 h-12 bg-primary-900 flex items-center justify-center mb-6">
              <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={s.icon}/>
              </svg>
            </div>
            <h3 class="font-bold text-primary-900 text-xl mb-2">{s.title}</h3>
            <p class="font-display text-accent-600 font-semibold text-sm mb-4">{s.lead}</p>
            <p class="text-sm text-primary-600 leading-relaxed flex-1">{s.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ===== 大切にしている考え方 ===== -->
  <section class="py-24 px-4 bg-primary-900 text-white">
    <div class="max-w-5xl mx-auto">

      <div class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-400 text-xs font-semibold tracking-[0.2em] uppercase">Principle</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold">「なぜその制度なのか」を、<br/>社員に説明できる会社に。</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-4xl">
        <div class="space-y-5 text-primary-200 text-base leading-loose">
          <p>
            なぜその賃金なのか。なぜその手当があるのか。なぜその休暇なのか。理由を答えられる制度は、社員に信じてもらえます。答えられない制度は、不公平に見えた瞬間に信頼を失います。
          </p>
          <p>
            規程はあるのに、実際の運用と合っていない。判断の基準が、担当者の頭の中にしかない。そういう会社は珍しくありません。裁判になっていないから、問題になっていないだけです。
          </p>
        </div>
        <div class="space-y-4">
          {[
            ['法令に合っている', '最低限の条件です。ここから始めます。'],
            ['目的に合っている', 'その制度は、何のためにあるのか。'],
            ['扱いに一貫性がある', '同じ事情の社員に、同じ答えを返せるか。'],
            ['現場で続けられる', '作った制度を、管理職が回せるか。'],
          ].map(([t, d]) => (
            <div class="border-l-2 border-accent-500 pl-5">
              <p class="font-bold text-white">{t}</p>
              <p class="text-sm text-primary-300">{d}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="mt-12 text-primary-300 text-base leading-relaxed max-w-3xl">
        社員それぞれの事情に向き合いながら、周囲の負担と事業の継続も踏まえて、働き続けられる仕組みを整える。それが、両立支援を入口にしている理由です。
      </p>

    </div>
  </section>


  <!-- ===== 顧問契約 ===== -->
  <section id="retainer" class="py-24 px-4 bg-warm-50">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Retainer</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">顧問契約</h2>
        <p class="mt-4 text-primary-500 text-base max-w-2xl">
          従業員10〜49人程度の会社を中心にお受けしています。会社の経緯を知っている相手に、次も相談できる。それが顧問の価値だと考えています。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-14">
        {retainers.map((r) => (
          <div class="bg-white border border-warm-200 overflow-hidden">
            <div class="h-1 bg-accent-500"></div>
            <div class="p-8">
              <h3 class="font-display text-2xl font-bold text-primary-900 mb-2">{r.name}</h3>
              <p class="text-sm text-primary-500 mb-6">{r.who}</p>
              <ul class="space-y-2.5">
                {r.items.map((it) => (
                  <li class="flex items-start gap-3 text-base text-primary-700">
                    <span class="w-1.5 h-1.5 bg-accent-500 rounded-full mt-2.5 shrink-0"></span>
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="bg-white border border-warm-200 p-8 md:p-10 mb-10">
        <h3 class="font-bold text-primary-900 text-lg mb-6">顧問として、何をするか</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {steps.map((s, i) => (
            <div>
              <p class="text-xs font-semibold text-accent-600 tracking-[0.15em] mb-2">{String(i + 1).padStart(2, '0')}</p>
              <h4 class="font-bold text-primary-900 mb-2">{s.title}</h4>
              <p class="text-sm text-primary-600 leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 pt-6 border-t border-warm-200 text-sm text-primary-500 leading-relaxed">
          既存の規則の解釈と運用は顧問の範囲です。就業規則の新規作成や大幅な改定、社内説明会、認定申請の支援は、範囲を決めて別途お見積りします。
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 justify-between">
        <p class="text-sm text-primary-600 leading-relaxed max-w-xl">
          受付はお問い合わせフォームとメール。受付後、原則2営業日以内に一次回答をお返しします。面談はオンラインと対面のどちらにも対応します。
        </p>
        <a href="/price/"
           class="inline-flex items-center gap-2 border border-primary-900 text-primary-900 hover:bg-primary-900 hover:text-white font-bold px-6 py-3 transition-colors duration-200 shrink-0">
          料金表を見る
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

    </div>
  </section>


  <!-- ===== なぜこの事務所か ===== -->
  <section class="py-24 px-4 bg-white">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Why</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">なぜ、この事務所か</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 max-w-4xl">
        {reasons.map((r) => (
          <div>
            <h3 class="font-bold text-primary-900 text-base mb-2 leading-snug">{r.label}</h3>
            <p class="text-sm text-primary-600 leading-relaxed">{r.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ===== 日々の計算ツール（小さな専門家.jp へ） ===== -->
  <section class="py-24 px-4 bg-warm-50">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-6 h-px bg-accent-500"></div>
        <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Tools</p>
      </div>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">日々の計算は、小さな専門家.jp へ</h2>
      <p class="mt-4 text-primary-600 text-base leading-relaxed max-w-2xl">
        有給の日数、最低賃金、育休中の手取り、高年齢雇用継続給付。当事務所の代表が企画・監修する計算ツールを、別サイトで公開しています。面倒な計算はそちらに任せて、ここでは会社と社員のことを考えます。
      </p>
      <a href="https://chiisanasenmonka.jp/"
         class="mt-8 inline-flex items-center gap-2 bg-primary-900 text-white font-bold py-4 px-8 rounded-lg hover:bg-accent-500 transition-colors duration-200">
        ツール一覧を見る
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>


  <!-- ===== プロフィール ===== -->
  <section id="profile" class="py-24 px-4 bg-white">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Profile</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">代表紹介</h2>
      </div>

      <div class="bg-white border border-warm-200 overflow-hidden max-w-3xl">
        <div class="h-1 bg-accent-500"></div>
        <div class="flex flex-col sm:flex-row">

          <div class="sm:w-52 shrink-0 flex items-center justify-center bg-warm-50 p-8 border-b sm:border-b-0 sm:border-r border-warm-200">
            <img
              src="/profile.png"
              alt="大日川 聡一（おびかわ としかず）"
              class="w-36 h-36 rounded-full object-cover shadow-md"
            />
          </div>

          <div class="flex-1 px-8 py-8">
            <p class="text-xs font-semibold text-accent-600 tracking-[0.15em] mb-1">社会保険労務士</p>
            <h3 class="font-display text-2xl font-bold text-primary-900 mb-0.5">大日川 聡一</h3>
            <p class="text-sm text-primary-400 mb-5">おびかわ としかず</p>

            <div class="flex flex-wrap gap-2 mb-6">
              {['社会保険労務士', '両立支援コーディネーター', '健康経営エキスパートアドバイザー'].map((q) => (
                <span class="text-xs bg-primary-50 text-primary-700 border border-primary-100 px-3 py-1 font-medium">{q}</span>
              ))}
            </div>

            <div class="space-y-3 text-base text-primary-700 leading-relaxed">
              <p>企業の役員・管理職としての実務と、社会保険労務士の業務を兼務しています。制度を作る側と、運用する側の両方にいることが、「なぜその制度なのか」を説明できる制度づくりに生きています。</p>
              <p class="font-display text-base font-semibold text-accent-600">
                「なぜその制度なのか」を、社員に説明できる会社に。
              </p>
              <p>立場によって、使える裁量や支援は異なります。自分の経験だけで判断せず、ご相談者の会社の状況を伺うことを大切にしています。</p>
            </div>

            <div class="mt-5 space-y-2 text-xs text-primary-400">
              {['愛知働き方改革推進支援センター　専門家', '愛知県男性育児休業取得促進アドバイザー', '愛知県治療と仕事の両立支援アドバイザー'].map((c) => (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-accent-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  <span>{c}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>


  <!-- ===== ご相談の流れ ===== -->
  <section class="py-24 px-4 bg-warm-50">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">Flow</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">ご相談の流れ</h2>
      </div>

      <div class="max-w-3xl relative">
        <div class="hidden sm:block absolute top-8 left-[calc(12.5%+16px)] right-[calc(12.5%+16px)] h-px bg-accent-200 z-0"></div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-8 sm:gap-4">
          {[
            { step: '01', title: 'お問い合わせ', desc: 'フォームまたはお電話でご連絡ください' },
            { step: '02', title: 'ヒアリング',   desc: '会社の状況と、いま困っている場面を伺います' },
            { step: '03', title: 'ご提案',       desc: '支援の内容と範囲、お見積りをご提示します' },
            { step: '04', title: '支援開始',     desc: 'ご契約後、現状の確認から始めます' },
          ].map((flow) => (
            <div class="flex flex-col items-center text-center relative z-10">
              <div class="w-16 h-16 bg-primary-900 border-2 border-accent-500 flex flex-col items-center justify-center mb-4">
                <span class="text-[10px] font-semibold text-accent-400 leading-none tracking-widest">STEP</span>
                <span class="font-display text-xl font-bold text-white">{flow.step}</span>
              </div>
              <h3 class="font-bold text-primary-900 mb-1.5">{flow.title}</h3>
              <p class="text-xs text-primary-500 leading-relaxed">{flow.desc}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>


  <!-- ===== よくあるご質問 ===== -->
  <section class="py-24 px-4 bg-white">
    <div class="max-w-5xl mx-auto">

      <div class="mb-14">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-6 h-px bg-accent-500"></div>
          <p class="text-accent-600 text-xs font-semibold tracking-[0.2em] uppercase">FAQ</p>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-primary-900">よくあるご質問</h2>
      </div>

      <div class="max-w-3xl divide-y divide-warm-200 border-t border-b border-warm-200">
        {faqs.map((f) => (
          <div class="py-7">
            <h3 class="flex items-start gap-4 font-bold text-primary-900 text-base mb-3">
              <span class="font-display text-accent-500 shrink-0">Q.</span>
              <span>{f.q}</span>
            </h3>
            <p class="flex items-start gap-4 text-sm text-primary-600 leading-relaxed">
              <span class="font-display font-bold text-primary-400 shrink-0">A.</span>
              <span>{f.a}</span>
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ===== CTA ===== -->
  <section class="py-24 px-4 bg-primary-900 text-white relative overflow-hidden">

    <div class="absolute inset-0 opacity-[0.03]">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="cta-grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#cta-grid)"/>
      </svg>
    </div>

    <div class="relative max-w-3xl mx-auto text-center">

      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-8 h-px bg-accent-500"></div>
        <p class="text-accent-400 text-xs font-semibold tracking-[0.3em] uppercase">Contact</p>
        <div class="w-8 h-px bg-accent-500"></div>
      </div>

      <h2 class="font-display text-3xl sm:text-5xl font-bold mb-8 leading-tight">まずは、いまの状況を<br class="sm:hidden"/>聞かせてください。</h2>

      <div class="flex flex-wrap justify-center gap-3 mb-10 text-base">
        {['両立支援の制度を整えたい', '就業規則の運用を見直したい', '顧問契約を検討している'].map((item) => (
          <span class="inline-flex items-center gap-2 border border-primary-700 px-5 py-2.5 text-primary-200">
            <span class="w-1.5 h-1.5 bg-accent-500 rounded-full shrink-0"></span>
            {item}
          </span>
        ))}
      </div>

      <p class="text-primary-300 mb-10 text-base">初回のご相談は無料です。</p>

      <a href="/contact/"
         class="inline-flex items-center gap-3 bg-accent-500 hover:bg-accent-400 text-white font-bold px-12 py-4 text-lg transition-colors duration-200">
        お問い合わせはこちら
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>

    </div>
  </section>

</Layout>
